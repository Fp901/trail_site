---
// ElevationChart — replaces the Google Maps "Elevation profile" screenshots
// (elevation-day2/3/4.png) with a hand-authored inline SVG, matching the
// route map's own philosophy (Part 8.6 note: "a hand-authored illustrative
// SVG, not a mapping library"). Distance and elevation figures are the real
// reported values (see elevationAlt on each itinerary day); the curve shape
// is illustrative, not a literal GPS trace, exactly like the route map board.
//
// Colour comes from the *existing* [data-accent] system (global.css): the
// ancestor <li class="daycard" data-accent="day2"> already sets --accent, so
// this component only ever reads var(--accent) — never an inline style or an
// SVG presentation attribute carrying a literal colour, which the site's CSP
// would drop in production (see DayCard's own note on --accent).
interface Props {
  day: number;
  points: [number, number][]; // [distance fraction 0..1, elevation metres]
  axisMin: number; // real reported low point (metres) — sets the bottom gridline
  axisMax: number; // real reported high point (metres) — sets the top gridline
  axisStep: number; // gridline spacing (metres)
  distanceKm: number; // real reported distance
  landmarkLabel: string; // named feature at the callout point (from the day's own copy)
  landmarkFrac: number; // where along the walk that feature sits (0..1)
  alt: string; // exact existing elevationAlt copy — unchanged, carried onto the SVG
}

const { day, points, axisMin, axisMax, axisStep, distanceKm, landmarkLabel, landmarkFrac, alt } =
  Astro.props;

// The viewBox is a coordinate space, not a size: the SVG renders at width:100% of whatever
// column it lands in, so every unit inside it — including text — is multiplied by
// (rendered width / W). That is why the axis labels used to come out at 3.9px on desktop. The
// geometry below is unchanged in proportion; the type is pulled out into CSS custom properties
// (--elev-fs / --elev-fs-lm) that are re-set per breakpoint so the EFFECTIVE size stays ~10px
// at every viewport, and strokes use non-scaling-stroke so they stay crisp too.
const W = 600;
const H = 230;
// The elevation labels sit just ABOVE their own gridline, inside the plot, rather than in a
// left-hand gutter. A gutter cannot work here: the label's font-size is a CSS variable that
// changes per breakpoint (see the style block), so no fixed PAD_L is wide enough at the mobile
// size and not absurd at the desktop one — at 16 units the old 52-unit gutter clipped "1,166 m"
// to "!66 m". Labels inside the plot also buy the curve the full width.
const PAD_L = 14;
const PAD_R = 14;
const PAD_T = 34;
const PAD_B = 30;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const xOf = (f: number) => PAD_L + f * plotW;
const yOf = (e: number) => PAD_T + (1 - (e - axisMin) / (axisMax - axisMin)) * plotH;

const linePts = points.map(([f, e]) => [xOf(f), yOf(e)] as [number, number]);
const lineD = 'M ' + linePts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L ');
const areaD = `${lineD} L ${linePts[linePts.length - 1][0].toFixed(1)} ${(PAD_T + plotH).toFixed(1)} L ${linePts[0][0].toFixed(1)} ${(PAD_T + plotH).toFixed(1)} Z`;

const gridLines: number[] = [];
for (let e = axisMin; e <= axisMax + 0.01; e += axisStep) gridLines.push(e);

let landmarkX = xOf(landmarkFrac);
let landmarkY = yOf(axisMax);
for (const [f, e] of points) {
  if (Math.abs(f - landmarkFrac) < 0.02) {
    landmarkX = xOf(f);
    landmarkY = yOf(e);
    break;
  }
}

// The landmark label is centred on its stem, which clips the moment the stem is near an edge:
// Day 4's landmark is Rustwood at landmarkFrac 0, so a centred label ran from roughly -40 to
// +44 in viewBox units and rendered as "ckwood". Anchoring cannot be decided from the text's
// measured width, because the font-size is a CSS variable that changes per breakpoint — so the
// anchor flips on POSITION instead, which needs no width: hard against the left edge the label
// runs rightwards, hard against the right edge it runs leftwards, and anywhere else it centres.
const nearStart = landmarkFrac <= 0.12;
const nearEnd = landmarkFrac >= 0.88;
const landmarkAnchor = nearStart ? 'start' : nearEnd ? 'end' : 'middle';
const landmarkTextX = nearStart ? landmarkX + 5 : nearEnd ? landmarkX - 5 : landmarkX;

const gradientId = `elevchart-fill-day${day}`;
---

<figure class="elevchart" data-elevchart>
  <div class="elevchart__stats">
    <span><strong>{distanceKm.toFixed(2)} km</strong></span>
    <span>{Math.round(axisMin).toLocaleString()}&ndash;{Math.round(axisMax).toLocaleString()} m</span>
  </div>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="elevchart__svg"
    role="img"
    aria-label={alt}
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" class="elevchart__stop-a" />
        <stop offset="100%" class="elevchart__stop-b" />
      </linearGradient>
    </defs>
    {
      gridLines.map((e) => (
        <line
          x1={PAD_L}
          y1={yOf(e)}
          x2={W - PAD_R}
          y2={yOf(e)}
          class="elevchart__grid"
          vector-effect="non-scaling-stroke"
        />
      ))
    }
    <path d={areaD} class="elevchart__area" fill={`url(#${gradientId})`} />
    <path d={lineD} class="elevchart__line" vector-effect="non-scaling-stroke" />
    <line
      x1={landmarkX}
      y1={landmarkY}
      x2={landmarkX}
      y2={PAD_T - 6}
      class="elevchart__stem"
      vector-effect="non-scaling-stroke"
    />
    <circle cx={landmarkX} cy={landmarkY} r="5" class="elevchart__dot" vector-effect="non-scaling-stroke" />
    <text
      x={landmarkTextX}
      y={PAD_T - 12}
      class="elevchart__landmark"
      text-anchor={landmarkAnchor}
    >
      {landmarkLabel}
    </text>
    {/* Elevation labels are drawn AFTER the curve, not with their gridlines: they sit inside the
        plot, so drawn first the line ran straight through them and the halo was painted under it.
        The lowest gridline gets no label at all — the curve starts and ends on the baseline, so
        that one is unreadable at any width, and its value is in the stats row above the chart. */}
    {
      gridLines.map((e, i) =>
        i > 0 ? (
          <text x={PAD_L + 3} y={yOf(e) - 5} class="elevchart__axislabel" text-anchor="start">
            {Math.round(e).toLocaleString()} m
          </text>
        ) : null,
      )
    }
    <text x={PAD_L} y={H - 8} class="elevchart__axislabel" text-anchor="start">0 km</text>
    <text x={W - PAD_R} y={H - 8} class="elevchart__axislabel" text-anchor="end">
      {distanceKm.toFixed(2)} km
    </text>
  </svg>
</figure>

<style>
  /* Type inside an SVG is scaled by (rendered width / viewBox width) along with everything else.
     This chart renders at width:100% of whatever column it lands in, so a single hard-coded
     font-size cannot work: at the desktop column width the 10px labels were coming out at 3.9px.
     --elev-fs and --elev-fs-lm are viewBox units, re-set per breakpoint to cancel the scale
     factor, so the EFFECTIVE size on screen stays around 10.5px and 12px everywhere. Stroke
     widths are handled by vector-effect="non-scaling-stroke" on the elements themselves. */
  .elevchart {
    margin: 0;
    /* Mobile: the chart reclaims the day-marker column (see .daycard__media in global.css), so
       it renders around 298px wide on a 390px phone => scale ~0.5. */
    --elev-fs: 21px;
    --elev-fs-lm: 24px;
  }
  @media (min-width: 640px) {
    /* From here to 1024px the card body is undivided, so the chart runs close to the card's full
       inner width and the scale factor climbs past 1. Each bracket below is the measured scale
       at that width, inverted, so the rendered size lands at ~10.5px throughout. */
    .elevchart {
      --elev-fs: 12px;
      --elev-fs-lm: 13.5px;
    }
  }
  @media (min-width: 768px) {
    .elevchart {
      --elev-fs: 10px;
      --elev-fs-lm: 11.5px;
    }
  }
  @media (min-width: 1024px) {
    /* The card splits into two columns here: the chart takes the media column. */
    .elevchart {
      --elev-fs: 18px;
      --elev-fs-lm: 20px;
    }
  }
  @media (min-width: 1280px) {
    /* And the card widens to the full page container, so the media column grows again. */
    .elevchart {
      --elev-fs: 14.5px;
      --elev-fs-lm: 16.5px;
    }
  }
  .elevchart__stats {
    display: flex;
    gap: 0.75rem;
    font-size: var(--text-xs);
    color: var(--color-charcoal);
    opacity: 0.72;
    margin-bottom: 0.35rem;
    font-variant-numeric: tabular-nums;
  }
  .elevchart__stats strong {
    color: var(--color-charcoal);
    opacity: 1;
    font-weight: 600;
  }
  .elevchart__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .elevchart__grid {
    stroke: var(--color-hairline);
    stroke-width: 1;
  }
  .elevchart__axislabel {
    font-size: var(--elev-fs);
    fill: var(--color-charcoal);
    opacity: 0.62;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    /* The labels sit inside the plot, so the curve can run straight through one. A halo in the
       card's own background keeps them readable wherever the line happens to fall. Sized in em
       so it tracks --elev-fs across the breakpoints instead of needing its own ladder. */
    paint-order: stroke fill;
    stroke: color-mix(in srgb, var(--accent) 4%, var(--color-cream));
    stroke-width: 0.28em;
    stroke-linejoin: round;
  }
  .elevchart__stop-a {
    stop-color: var(--accent);
    stop-opacity: 0.3;
  }
  .elevchart__stop-b {
    stop-color: var(--accent);
    stop-opacity: 0.02;
  }
  .elevchart__area {
    stroke: none;
  }
  .elevchart__line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .elevchart__stem {
    stroke: var(--accent);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
    opacity: 0.7;
  }
  .elevchart__dot {
    fill: var(--accent);
    stroke: var(--color-cream);
    stroke-width: 1.75;
  }
  .elevchart__landmark {
    font-size: var(--elev-fs-lm);
    font-weight: 600;
    fill: var(--accent-ink, var(--accent));
    font-family: var(--font-body);
    paint-order: stroke fill;
    stroke: color-mix(in srgb, var(--accent) 4%, var(--color-cream));
    stroke-width: 0.28em;
    stroke-linejoin: round;
  }
</style>
