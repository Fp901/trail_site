---
// ElevationChart — replaces the Google Maps "Elevation profile" screenshots
// (elevation-day2/3/4.png) with a hand-authored inline SVG, matching the
// route map's own philosophy (Part 8.6 note: "a hand-authored illustrative
// SVG, not a mapping library"). Distance and elevation figures are the real
// reported values (see elevationAlt on each itinerary day); the curve shape
// is illustrative, not a literal GPS trace, exactly like the route map board.
//
// Colour comes from the *existing* [data-accent] system (global.css): the
// ancestor <li class="daycard" data-accent="day2"> already sets --accent, so
// this component only ever reads var(--accent) — never an inline style or an
// SVG presentation attribute carrying a literal colour, which the site's CSP
// would drop in production (see DayCard's own note on --accent).
interface Props {
  day: number;
  points: [number, number][]; // [distance fraction 0..1, elevation metres]
  axisMin: number; // real reported low point (metres) — sets the bottom gridline
  axisMax: number; // real reported high point (metres) — sets the top gridline
  axisStep: number; // gridline spacing (metres)
  distanceKm: number; // real reported distance
  landmarkLabel: string; // named feature at the callout point (from the day's own copy)
  landmarkFrac: number; // where along the walk that feature sits (0..1)
  alt: string; // exact existing elevationAlt copy — unchanged, carried onto the SVG
}

const { day, points, axisMin, axisMax, axisStep, distanceKm, landmarkLabel, landmarkFrac, alt } =
  Astro.props;

const W = 600;
const H = 200;
const PAD_L = 46;
const PAD_R = 12;
const PAD_T = 22;
const PAD_B = 24;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

const xOf = (f: number) => PAD_L + f * plotW;
const yOf = (e: number) => PAD_T + (1 - (e - axisMin) / (axisMax - axisMin)) * plotH;

const linePts = points.map(([f, e]) => [xOf(f), yOf(e)] as [number, number]);
const lineD = 'M ' + linePts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L ');
const areaD = `${lineD} L ${linePts[linePts.length - 1][0].toFixed(1)} ${(PAD_T + plotH).toFixed(1)} L ${linePts[0][0].toFixed(1)} ${(PAD_T + plotH).toFixed(1)} Z`;

const gridLines: number[] = [];
for (let e = axisMin; e <= axisMax + 0.01; e += axisStep) gridLines.push(e);

let landmarkX = xOf(landmarkFrac);
let landmarkY = yOf(axisMax);
for (const [f, e] of points) {
  if (Math.abs(f - landmarkFrac) < 0.02) {
    landmarkX = xOf(f);
    landmarkY = yOf(e);
    break;
  }
}

const gradientId = `elevchart-fill-day${day}`;
---

<figure class="elevchart" data-elevchart>
  <div class="elevchart__stats">
    <span><strong>{distanceKm.toFixed(2)} km</strong></span>
    <span>{Math.round(axisMin).toLocaleString()}&ndash;{Math.round(axisMax).toLocaleString()} m</span>
  </div>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="elevchart__svg"
    role="img"
    aria-label={alt}
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" class="elevchart__stop-a" />
        <stop offset="100%" class="elevchart__stop-b" />
      </linearGradient>
    </defs>
    {
      gridLines.map((e) => (
        <>
          <line x1={PAD_L} y1={yOf(e)} x2={W - PAD_R} y2={yOf(e)} class="elevchart__grid" />
          <text x={PAD_L - 8} y={yOf(e) + 3.5} class="elevchart__axislabel" text-anchor="end">
            {Math.round(e).toLocaleString()} m
          </text>
        </>
      ))
    }
    <path d={areaD} class="elevchart__area" fill={`url(#${gradientId})`} />
    <path d={lineD} class="elevchart__line" />
    <line x1={landmarkX} y1={landmarkY} x2={landmarkX} y2={PAD_T - 5} class="elevchart__stem" />
    <circle cx={landmarkX} cy={landmarkY} r="4" class="elevchart__dot" />
    <text x={landmarkX} y={PAD_T - 10} class="elevchart__landmark" text-anchor="middle">
      {landmarkLabel}
    </text>
    <text x={PAD_L} y={H - 6} class="elevchart__axislabel" text-anchor="start">0 km</text>
    <text x={W - PAD_R} y={H - 6} class="elevchart__axislabel" text-anchor="end">
      {distanceKm.toFixed(2)} km
    </text>
  </svg>
</figure>

<style>
  .elevchart {
    margin: 0;
  }
  .elevchart__stats {
    display: flex;
    gap: 12px;
    font-size: 0.76rem;
    color: var(--color-charcoal);
    opacity: 0.72;
    margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
  }
  .elevchart__stats strong {
    color: var(--color-charcoal);
    opacity: 1;
    font-weight: 600;
  }
  .elevchart__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .elevchart__grid {
    stroke: var(--color-hairline);
    stroke-width: 1;
  }
  .elevchart__axislabel {
    font-size: 10px;
    fill: var(--color-charcoal);
    opacity: 0.55;
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }
  .elevchart__stop-a {
    stop-color: var(--accent);
    stop-opacity: 0.3;
  }
  .elevchart__stop-b {
    stop-color: var(--accent);
    stop-opacity: 0.02;
  }
  .elevchart__area {
    stroke: none;
  }
  .elevchart__line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .elevchart__stem {
    stroke: var(--accent);
    stroke-width: 1.25;
    stroke-dasharray: 2 2;
    opacity: 0.7;
  }
  .elevchart__dot {
    fill: var(--accent);
    stroke: var(--color-cream);
    stroke-width: 1.5;
  }
  .elevchart__landmark {
    font-size: 10.5px;
    font-weight: 600;
    fill: var(--accent-ink, var(--accent));
    font-family: var(--font-body);
  }
</style>
