---
// RatesTable — commercial model v4. One glanceable price matrix for the FLAGSHIP product only:
// rate years as rows, seasons as columns, three columns wide so it fits a 380px phone without
// sideways scrolling. Each published rate year has two rows: the flagship rate, then the SADC
// resident rate (public since the operator's 23 September 2026 decision; CLAUDE.md Part 17.1).
// operator's memo sets it out. All figures come from data/rates.ts, which lib/pricing.ts charges
// from, so the table and the checkout cannot drift.
//
// Prices are PER PERSON SHARING, for the whole NIGHTS-night trail, VAT and conservation levies
// included. There is no shorter stay to choose, so no nightly figure appears anywhere.
//
// Currency: ZAR is the default and only CHARGED currency (Paystack bills in ZAR — see
// lib/payments.ts). The EUR/GBP/USD tabs are a static, indicative conversion for foreign guests
// browsing the page, from a monthly ECB snapshot (scripts/update-fx-rates.mjs); every currency's
// figure is pre-computed at build time into a data attribute,
// and the tiny script below only chooses which pre-rendered string to show — there is no runtime
// conversion logic to duplicate or drift from data/rates.ts.
import {
  rateRows,
  sadcRateRows,
  SADC_DISCOUNT_PERCENT,
  formatRand,
  formatForeign,
  SEASON_HIGH_LABEL,
  SEASON_HIGH_DATE_RANGES,
  SEASON_LOW_LABEL,
  FX_RATES_AS_OF,
  FX_RATES_AS_OF_LABEL,
  type ForeignCurrency,
  SINGLE_SUPPLEMENT_PCT,
} from '../data/rates';
import { withBase } from '../data/site';

const CURRENCIES: Array<'ZAR' | ForeignCurrency> = ['ZAR', 'EUR', 'GBP', 'USD'];

// Flagship row then its SADC resident row, per rate year. The first year shows; later years sit
// behind a "Show {year} rates" toggle.
const rowPairs = rateRows.flatMap((r, i) => [
  { row: r, resident: false },
  { row: sadcRateRows[i], resident: true },
]);
const yearGroups = rateRows.map(({ year }, i) => ({
  year,
  later: i > 0,
  pairs: rowPairs.filter((p) => p.row.year === year),
}));

// Every cell's figure, once, in all four currencies — read back out by the client script via
// data-price-zar / -eur / -gbp / -usd rather than recomputed in JS.
function priceSet(rand: number): Record<string, string> {
  return {
    'data-price-zar': formatRand(rand),
    'data-price-eur': formatForeign(rand, 'EUR'),
    'data-price-gbp': formatForeign(rand, 'GBP'),
    'data-price-usd': formatForeign(rand, 'USD'),
  };
}
---

<div class="ratetable-wrap">
  {/* Currency tabs — radio buttons styled as chips (native, keyboard-operable, no JS framework),
      matching the filter-chip idiom already used in BookingWidget's calendar. ZAR pre-checked. */}
  <fieldset class="ratetable__currency" data-currency-tabs>
    <legend class="sr-only">Show prices in</legend>
    {
      CURRENCIES.map((cur) => (
        <label class="ratetable__curbtn">
          <input type="radio" name="ratetable-currency" value={cur} checked={cur === 'ZAR'} />
          <span>{cur}</span>
        </label>
      ))
    }
  </fieldset>

  {/* Rate years after the first sit behind a native disclosure, so the table opens on the year
      most guests book. Each later year is its own table with the same fixed column widths and its
      own header row, so it reads correctly on its own and lines up under the first when opened.
      Collapsed rows still carry every currency's figure, so the tabs convert them too. */}
  {
    yearGroups.map(({ year, pairs, later }) => {
      const Wrap = later ? 'details' : 'div';
      return (
        <Wrap class={later ? 'ratetable__more' : 'ratetable__first'}>
          {later && (
            <summary class="ratetable__moretoggle">
              <span class="ratetable__moreshow">Show {year} rates</span>
              <span class="ratetable__morehide">Hide {year} rates</span>
            </summary>
          )}
          <table class="ratetable">
            <caption class="sr-only">
              {year} all-inclusive rates per person sharing, for the whole trail, by season, with
              the SADC resident rate beneath. VAT and conservation levies included.
            </caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Rate year</span></th>
                <th scope="col">
                  {SEASON_HIGH_LABEL}
                  {/* One range per line, each non-wrapping. As a single comma-joined string this column
                      head broke mid-phrase ("15 Dec to" / "15 Jan"), which reads as two different dates;
                      stacking them is the deliberate version of the same break. */}
                  <span class="ratetable__seasonnote">
                    {SEASON_HIGH_DATE_RANGES.map((range) => (
                      <span class="ratetable__seasonrange">{range}</span>
                    ))}
                  </span>
                </th>
                <th scope="col">
                  {SEASON_LOW_LABEL}
                </th>
              </tr>
            </thead>
            <tbody>
              {pairs.map(({ row: r, resident }) => (
                <tr class={resident ? 'ratetable__row--resident' : 'ratetable__row--lead'}>
                  <th scope="row">
                    <span class="ratetable__label">{r.label}</span>
                    {resident ? (
                      <span class="ratetable__qualifier">
                        {SADC_DISCOUNT_PERCENT}% off &middot;{' '}
                        <a href={withBase('/logistics#sadc-resident')} class="ratetable__qualifies">
                          Who qualifies?
                        </a>
                      </span>
                    ) : (
                      <span class="ratetable__qualifier">all-inclusive, incl. VAT</span>
                    )}
                  </th>
                  <td>
                    <span class="ratetable__price" data-currency-price {...priceSet(r.high)}>
                      {formatRand(r.high)}
                    </span>
                    <span class="ratetable__unit">per person sharing</span>
                  </td>
                  <td>
                    <span class="ratetable__price" data-currency-price {...priceSet(r.low)}>
                      {formatRand(r.low)}
                    </span>
                    <span class="ratetable__unit">per person sharing</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </Wrap>
      );
    })
  }

  {/* Always visible, ZAR tab included: the snapshot date and the ZAR-only charge are facts about
      the whole table, not only about the converted figures. */}
  {/* Operator wording (25 September 2026), with the percentage read from the constant. */}
  <p class="ratetable__supplement">
    A Single Supplement of {SINGLE_SUPPLEMENT_PCT}% of the All-inclusive rate applies to all
    bookings regardless of SADC residency.
  </p>

  <p class="ratetable__fxnote" data-currency-note>
    <strong>Exchange rates as of <time datetime={FX_RATES_AS_OF}>{FX_RATES_AS_OF_LABEL}</time>.</strong>
    All payments are taken in South African Rand (ZAR). The euro, pound and dollar prices are
    converted from rand at the European Central Bank reference rate on that date, refreshed
    monthly, and are for information only. They are subject to change in line with exchange rates.
  </p>
</div>

<script>
  function initCurrencyTabs(): void {
    const wrap = document.querySelector<HTMLElement>('[data-currency-tabs]');
    if (!wrap || wrap.dataset.bound === 'true') return;
    wrap.dataset.bound = 'true';

    const prices = document.querySelectorAll<HTMLElement>('[data-currency-price]');

    function apply(currency: string): void {
      const key = `price${currency.charAt(0)}${currency.slice(1).toLowerCase()}`; // priceZar / priceEur / ...
      prices.forEach((el) => {
        const value = (el.dataset as Record<string, string | undefined>)[key];
        if (value) el.textContent = value;
      });
    }

    wrap.querySelectorAll<HTMLInputElement>('input[name="ratetable-currency"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) apply(input.value);
      });
    });

    const checked = wrap.querySelector<HTMLInputElement>('input[name="ratetable-currency"]:checked');
    apply(checked?.value ?? 'ZAR');
  }

  initCurrencyTabs();
  document.addEventListener('astro:page-load', initCurrencyTabs);
</script>
