---
// SanctuaryCard — Part 7 / 8.3. Alternating editorial feature row (distinct-but-cohesive,
// not three identical boxes). Renders an astro:assets <Image> when a photo is supplied; else
// a labelled accent-tinted placeholder (4:3). Per-card accent via accentVar.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AmenityIcon from './AmenityIcon.astro';
import type { GalleryPhoto, LodgeAmenity } from '../data/sanctuaries';

interface Props {
  id?: string; // anchor target, so /accommodation#rotavi etc. resolve from the homepage teasers
  // A second anchor for the same card. Temminck's Lodge is still keyed 'rotavi' throughout the
  // data layer (its former name), so /accommodation#rotavi has to keep working for any link
  // already in the wild — but a URL fragment is user-visible, and "#rotavi" names a lodge that
  // no longer exists by that name anywhere in the copy. aliasId adds "#temmincks" alongside it.
  aliasId?: string;
  name: string;
  role: string;
  description: string;
  alt: string; // heroImage's alt text
  accentVar: string;
  heroImage?: ImageMetadata;
  gallery?: GalleryPhoto[]; // supporting photos shown alongside the hero
  morePhotos?: GalleryPhoto[]; // extra photos shown only in the enlarged viewer
  reverse?: boolean;
  context?: string; // optional trail-context line (e.g. "Day 2 · Temminck's → Oukraal, over Groenkop")
  amenities?: LodgeAmenity[]; // optional per-lodge amenity list rendered with icons
}
const {
  id,
  aliasId,
  name,
  role,
  description,
  alt,
  accentVar,
  heroImage,
  gallery,
  morePhotos = [],
  reverse = false,
  context,
  amenities,
} = Astro.props;

// Every photo of this lodge, in viewing order (hero, the two on the card, then the extras), as
// enlarged, optimised images for the viewer (LodgeLightbox.astro). Built here at build time and
// handed to the page as one data attribute, so the viewer's script holds no image data of its own.
const allPhotos: GalleryPhoto[] = [
  ...(heroImage ? [{ image: heroImage, alt }] : []),
  ...(gallery ?? []),
  ...morePhotos,
];
const viewerPhotos = await Promise.all(
  allPhotos.map(async (p) => {
    const img = await getImage({ src: p.image, widths: [800, 1400, 2000], format: 'webp' });
    return {
      src: img.src,
      srcset: img.srcSet.attribute,
      width: p.image.width,
      height: p.image.height,
      alt: p.alt,
    };
  }),
);
const viewerData = JSON.stringify({ lodge: name, photos: viewerPhotos });
---

<article
  id={id}
  class:list={['sanctuary', reverse && 'sanctuary--reverse']}
  data-accent={accentVar.replace('--color-', '')}
  data-lightbox-photos={viewerData}
>
  {aliasId && <span id={aliasId} class="anchor-alias" aria-hidden="true" />}
  <div class="sanctuary__media">
    {
      heroImage ? (
        <button type="button" class="sanctuary__zoom" data-lightbox-open data-index="0" aria-label={`Enlarge photo of ${name}: ${alt}`}>
          <Image
            src={heroImage}
            alt=""
            class="sanctuary__img"
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 50vw, 100vw"
            loading="lazy"
          />
        </button>
      ) : (
        <div class="sanctuary__placeholder" role="img" aria-label={alt} />
      )
    }
    {
      gallery && gallery.length > 0 && (
        <div class="sanctuary__gallery">
          {gallery.map((photo, i) => (
            <button
              type="button"
              class="sanctuary__zoom"
              data-lightbox-open
              data-index={String(i + (heroImage ? 1 : 0))}
              aria-label={`Enlarge photo of ${name}: ${photo.alt}`}
            >
              <Image
                src={photo.image}
                alt=""
                class="sanctuary__gallery-img"
                widths={[320, 480]}
                sizes="(min-width: 768px) 25vw, 50vw"
                loading="lazy"
              />
            </button>
          ))}
        </div>
      )
    }
    {
      viewerPhotos.length > 1 && (
        <button type="button" class="sanctuary__viewall" data-lightbox-open data-index="0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M21 16l-5-5-8 8"/></svg>
          View all {viewerPhotos.length} photos
          <span class="sr-only"> of {name}</span>
        </button>
      )
    }
  </div>

  <div class="sanctuary__body">
    <p class="sanctuary__role">{role}</p>
    <h2 class="sanctuary__name">{name}</h2>
    {context && <p class="sanctuary__context">{context}</p>}
    <p class="sanctuary__desc">{description}</p>
    {
      amenities && amenities.length > 0 && (
        <p class="sanctuary__amenities-label">Lodge amenities</p>
      )
    }
    {
      amenities && amenities.length > 0 && (
        <ul class="sanctuary__amenities">
          {amenities.map((a) => (
            <li class="sanctuary__amenity">
              <span class="sanctuary__amenity-icon">
                <AmenityIcon name={a.icon} />
              </span>
              {a.label}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
