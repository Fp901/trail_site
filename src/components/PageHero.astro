---
// PageHero — full-bleed photo header for interior pages (The Trail, Logistics & FAQ), matching
// the approved wireframe's "trail-header"/"logistics-header" treatment: a shorter, capped-height
// sibling of the Home <Hero> rather than a second full-viewport hero. The copy panel is pulled up
// over the bottom of the photo with a negative margin and carries its own gradient background —
// simpler than Hero's absolutely-positioned scrim, and appropriate for a shorter band where the
// image itself still reads clearly above the fold.
// Content (eyebrow/h1/paragraphs) is passed via the default slot so the real, unedited page copy
// — including its own heading id, used elsewhere for aria-labelledby — passes through untouched;
// this component only supplies the new photo + overlay layout around it.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  labelledby?: string;
}
const { image, imageAlt, labelledby } = Astro.props;
---

<section class="page-hero" aria-labelledby={labelledby}>
  <Image
    src={image}
    alt={imageAlt}
    class="page-hero__media"
    loading="eager"
    fetchpriority="high"
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
  />
  <div class="page-hero__content mx-auto w-full page-container px-6 md:px-8 lg:px-10">
    <slot />
  </div>
</section>
