---
// BookingWidget — commercial model v4 (memo to Francois, 15 September 2026). Vanilla-JS island.
//
// WHAT THE GUEST DECIDES (rooms model, 23 September 2026). Four steps: the group (walkers, how
// many need their own room, how many are SADC residents, and the age and SADC confirmations),
// a start date, contact details, then review and pay. Catering is NOT a question: it is a
// property of the PAGE. /rates mounts this widget catered (the flagship), and the hidden
// /sadc-slackpacking page mounts it self-catered, fixed at 8 SADC residents sharing 4 rooms.
//
// ROOMS. A departure has 4 double rooms and takes at most 8 walkers. Guests only share within
// their own booking, so a party uses singleRooms + (walkers - singleRooms) / 2 rooms, and a date
// fills on rooms. A solo walker can only join a date someone has already booked.
//
// PRICES ARE PUBLIC AND SHIP WITH THE PAGE. The all-inclusive rate, the SADC 30% and the 40%
// single supplement are all stated on the rates page, so the estimate is computed here from the
// constants in data/rates.ts. The server recomputes every line at checkout and never reads a
// figure from the browser; the browser sends counts, not a price or a rate band.
//
// AVAILABILITY. One read of the derived `departure_inventory` view (migration 0017), which is
// SPARSE — an absent date has no state and is wide open. The contract is applied in exactly one
// place, departureFor(), which everything downstream goes through. "Exclusive" is not a product:
// it is what a party gets by taking all 4 rooms.
//
// The wire payload is { startDate, catering, groupSize, singleRooms, sadcCount,
// residencyDeclaration, ageConfirmed, lead* }. bookingType is derived server-side, never sent.
import type { Catering } from '../lib/db.types';
import {
  NIGHTS,
  MAX_GROUP_SIZE,
  MIN_TO_JOIN,
  ROOMS_PER_DEPARTURE,
  SINGLE_SUPPLEMENT_PCT,
  SADC_PREMIUM_PCT,
  SADC_DISCOUNT,
  SADC_DISCOUNT_PERCENT,
  BASE_PP_TRIP,
  minPartySize,
  minToJoin,
  defaultSingleRooms,
  singleSupplementFor,
  SEASON_DISCOUNT,
  RATE_YEAR_MULTIPLIER,
  RATE_BASE_YEAR,
  RATE_LAST_YEAR,
  SADC_WINDOW_MONTHS,
  INTL_CATERED_WINDOW_MONTHS,
  LAST_MINUTE_MIN_DAYS,
  LAST_MINUTE_MAX_DAYS,
  LAST_MINUTE_DISCOUNT,
  TAPER_END_DATE,
  TAPER_BLOCKED_ISODOW,
  TAPER_END_DISPLAY,
  START_DAYS_DISPLAY,
  formatRand,
} from '../data/rates';
import { SADC_COUNTRIES, countryName } from '../data/countries';
import { site, withBase } from '../data/site';
import { refundPolicy, MIN_GUEST_AGE } from '../data/policies';
import { itinerary } from '../data/itinerary';
import {
  SPLIT_THRESHOLD_DAYS,
  BALANCE_LEAD_DAYS,
  earliestBookableDate,
  latestBookableDate,
} from '../lib/pricing';

interface Props {
  /** Which product this mount sells. The public /rates page is catered; the hidden
   *  /sadc-slackpacking page is self-catered. Never a question asked of the guest. */
  catering?: Catering;
}
const { catering = 'catered' } = Astro.props;

const isCatered = catering === 'catered';
const partyMin = minPartySize(catering);
// The SADC member states by name, alphabetical, from the list the FAQ also reads.
const sadcCountryNames = [...SADC_COUNTRIES].map(countryName).sort((a, b) => a.localeCompare(b));
// The supplement quoted before a date is chosen: base year, high season.
const supplementHint = singleSupplementFor({ year: RATE_BASE_YEAR, highSeason: true });
const earliest = earliestBookableDate();

// Where each night is spent, DERIVED from the itinerary rather than retyped: night N is the lodge
// you are at when day N ends, which the itinerary already states as day N's destination (day 1 has
// no walk, so its lodge is day 2's `from`). Keeping it derived means a change to the route updates
// the booking summary automatically instead of silently disagreeing with /the-trail.
const nightLodges = [
  itinerary[1]?.from ?? '',
  itinerary[1]?.to ?? '',
  itinerary[2]?.to ?? '',
].filter(Boolean);
const departureLodge = itinerary[itinerary.length - 1]?.to ?? '';

// Everything the client needs to mirror the server's price and date rules, as one JSON blob. The
// single source of truth stays data/rates.ts + lib/pricing.ts; this is a serialised copy for the
// ESTIMATE display only. The server always recomputes and is authoritative.
const clientRates = {
  nights: NIGHTS,
  catering,
  maxGroup: MAX_GROUP_SIZE,
  rooms: ROOMS_PER_DEPARTURE,
  partyMin,
  joinMin: minToJoin(catering),
  // Public rates, per person for the whole trail, before year, season and last-minute. The server
  // recomputes every figure at checkout; these only drive the on-screen estimate.
  baseRate: BASE_PP_TRIP[catering],
  sadcDiscount: isCatered ? SADC_DISCOUNT : 0,
  supplementPct: isCatered ? SINGLE_SUPPLEMENT_PCT : 0,
  sadcPercent: SADC_DISCOUNT_PERCENT,
  yearMultipliers: RATE_YEAR_MULTIPLIER,
  baseYear: RATE_BASE_YEAR,
  lastYear: RATE_LAST_YEAR,
  seasonDiscount: SEASON_DISCOUNT,
  lastMinuteMinDays: LAST_MINUTE_MIN_DAYS,
  lastMinuteMaxDays: LAST_MINUTE_MAX_DAYS,
  lastMinuteDiscount: LAST_MINUTE_DISCOUNT,
  taperEnd: TAPER_END_DATE,
  taperDows: TAPER_BLOCKED_ISODOW,
  startDays: START_DAYS_DISPLAY,
  taperEndDisplay: TAPER_END_DISPLAY,
  splitDays: SPLIT_THRESHOLD_DAYS,
  balanceLeadDays: BALANCE_LEAD_DAYS,
  earliest,
  // Booking window: 24 months for a catered party with no SADC guests, 12 as soon as anyone is
  // counted as SADC (and always for self-catered). Step 1 is answered first, so the right one is
  // known before the calendar draws.
  latestIntl: latestBookableDate(catering, 0),
  latestSadc: latestBookableDate(catering, 1),
  monthsIntl: isCatered ? INTL_CATERED_WINDOW_MONTHS : SADC_WINDOW_MONTHS,
  monthsSadc: SADC_WINDOW_MONTHS,
  nightLodges,
  departureLodge,
};
---

<div class="resume-prompt" data-resume-prompt hidden role="status" aria-live="polite">
  <p class="resume-prompt__text">
    You have a booking waiting for payment. Continue to payment, or release it so you can start
    a new one?
  </p>
  <div class="resume-prompt__actions">
    <button type="button" class="btn btn-primary" data-resume-continue>Continue to payment</button>
    <button type="button" class="btn btn-secondary" data-resume-release>Release it</button>
  </div>
</div>

<form id="booking-form" class="bform" data-rates={JSON.stringify(clientRates)} novalidate>
  {/* ==== Step 1 — Your group. ================================================================
      The four steps below are a guided accordion: the current step is open, completed steps
      collapse to a one-line summary with an Edit link, later steps are visible but locked. All of
      that is added by JS at runtime — the markup ships with every step OPEN, so if the script
      fails the form degrades to the plain long-scroll version rather than an unusable stub.
      Step 1 carries every answer that changes the price or the calendar (walkers, own rooms,
      SADC count), so by step 2 the calendar can show prices and the right booking window. */}
  <div class="bstep" data-step="1">
    <div class="bstep__bar">
      <p class="bstep__heading"><span class="bstep__num">1</span>. Your group</p>
      <p class="bstep__summary" data-step-summary hidden></p>
      <button type="button" class="blink bstep__edit" data-step-edit hidden>Edit</button>
    </div>
    <div class="bstep__body" data-step-body>
      {isCatered ? (
        <Fragment>
          <fieldset class="bwalkers">
            <legend class="bwalkers__legend">How many walkers?</legend>
            {/* Discrete buttons, deliberately NOT a slider: eight values is a poor slider range and
                a slider is worse for keyboard and screen-reader users. Radio inputs give native
                arrow-key navigation for free. */}
            <div class="bwalkers__row">
              {Array.from({ length: MAX_GROUP_SIZE - MIN_TO_JOIN + 1 }, (_, i) => i + MIN_TO_JOIN).map((n) => (
                <label class="bwalkers__opt">
                  <input type="radio" name="groupSize" value={n} checked={n === partyMin} />
                  <span>{n}</span>
                </label>
              ))}
            </div>
            <p class="bstep__hint">
              Eight is the most any departure takes: two guides to eight walkers. A single walker
              can join a date another group has already booked.
            </p>
          </fieldset>

          {/* Own rooms. A stepper that only lands on values leaving an even number sharing, since
              guests only share within their own booking. The hidden input is what the form reads. */}
          <div class="form-field bform__count">
            <p class="bform__countlabel" id="bf-single-label">How many need their own room?</p>
            <p class="form-hint" id="bf-single-hint">
              Rooms are doubles and you only share within your group. Each guest in their own room
              pays a single supplement of <span data-supplement>{formatRand(supplementHint)}</span>.
            </p>
            <div class="bcount" role="group" aria-labelledby="bf-single-label" aria-describedby="bf-single-hint">
              <button type="button" class="bcount__btn" data-count-dec="single" aria-label="Fewer own rooms">
                <span aria-hidden="true">&minus;</span>
              </button>
              <output class="bcount__value" data-count-value="single" aria-live="polite">{defaultSingleRooms(partyMin)}</output>
              <button type="button" class="bcount__btn" data-count-inc="single" aria-label="More own rooms">
                <span aria-hidden="true">+</span>
              </button>
            </div>
            <input type="hidden" name="singleRooms" value={defaultSingleRooms(partyMin)} data-count-input="single" />
          </div>

          {/* SADC resident discount: shown openly, with the member states behind a disclosure. */}
          <div class="form-field bform__count bform__sadc">
            <p class="bform__sadchead">SADC resident discount: {SADC_DISCOUNT_PERCENT}% off</p>
            <p class="form-hint">
              Guests who live in a Southern African Development Community country get
              {' '}{SADC_DISCOUNT_PERCENT}% off their rate.
            </p>
            <details class="bform__countries">
              <summary>See the {sadcCountryNames.length} countries</summary>
              <p>{sadcCountryNames.join(', ')}</p>
            </details>
            <p class="bform__countlabel" id="bf-sadc-label">How many of your group live in an SADC country?</p>
            <div class="bcount" role="group" aria-labelledby="bf-sadc-label">
              <button type="button" class="bcount__btn" data-count-dec="sadc" aria-label="Fewer SADC residents">
                <span aria-hidden="true">&minus;</span>
              </button>
              <output class="bcount__value" data-count-value="sadc" aria-live="polite">0</output>
              <button type="button" class="bcount__btn" data-count-inc="sadc" aria-label="More SADC residents">
                <span aria-hidden="true">+</span>
              </button>
            </div>
            <input type="hidden" name="sadcCount" value="0" data-count-input="sadc" />
          </div>
        </Fragment>
      ) : (
        /* Self-catered runs as a full group of 8 SADC residents sharing 4 rooms: there is nothing
           to choose, so the values are fixed with the reason stated. */
        <div class="bstep__static">
          <p class="bstep__sub">
            The self-catered option runs as a full group of {partyMin}: two guides to eight
            walkers, with the trail and each lodge reserved for your group.
          </p>
          <input type="hidden" name="groupSize" value={partyMin} />
          <input type="hidden" name="singleRooms" value="0" data-count-input="single" />
          <input type="hidden" name="sadcCount" value={partyMin} data-count-input="sadc" />
        </div>
      )}

      {/* Child policy, both products: createCheckout refuses a booking without this tick. */}
      <div class="form-field bform__declaration">
        <p class="form-hint" id="bf-age-hint">
          For safety, every guest must be at least {MIN_GUEST_AGE} years old on the start date.
          <a href={withBase('/logistics#minimum-age')}>Read the age policy</a>
        </p>
        <label class="bform__radio">
          <input type="checkbox" name="ageConfirmed" data-age-confirm aria-describedby="bf-age-hint bf-age-err" />
          <span>I confirm every guest in this booking will be {MIN_GUEST_AGE} or older by the start date.</span>
        </label>
        <span class="form-error" id="bf-age-err" data-age-error aria-live="polite"></span>
      </div>

      {/* SADC confirmation. Catered: shown only once someone is counted as SADC. Self-catered:
          always, for all 8. createCheckout refuses an SADC count without it. */}
      <div class="form-field bform__declaration" data-residency-block hidden={isCatered}>
        <label class="bform__radio">
          <input type="checkbox" name="residencyDeclaration" data-residency-declare aria-describedby="bf-residency-err" />
          <span>
            {isCatered
              ? `I confirm these guests live in an SADC country and will show ID or a passport at registration on Day 1. Any guest who cannot will pay a ${SADC_PREMIUM_PCT}% premium at registration.`
              : `I confirm all ${partyMin} guests live in an SADC country and will show ID or a passport at registration on Day 1. Any guest who cannot will pay a ${SADC_PREMIUM_PCT}% premium at registration.`}
          </span>
        </label>
        <span class="form-error" id="bf-residency-err" data-residency-error aria-live="polite"></span>
      </div>

      <p class="bstep__notice" data-step-notice role="status" aria-live="polite" hidden></p>
      <button type="button" class="btn btn-primary bstep__continue" data-step-continue>Continue</button>
    </div>
  </div>

  {/* ==== Step 2 — Choose a start date. ======================================================= */}
  <div class="bstep" data-step="2">
    <div class="bstep__bar">
      <p class="bstep__heading" id="bf-cal-label"><span class="bstep__num">2</span>. Choose a start date</p>
      <p class="bstep__summary" data-step-summary hidden></p>
      <button type="button" class="blink bstep__edit" data-step-edit hidden>Edit</button>
    </div>
    <div class="bstep__body" data-step-body>
      <p class="bstep__sub">
        Day 1 is your arrival day. Departures run {START_DAYS_DISPLAY} until {TAPER_END_DISPLAY}.
      </p>
      <div class="form-field bform__datefield">
        <p class="bform__nextavail" data-nextavail hidden></p>
        <div class="bcal" data-calendar role="group" aria-labelledby="bf-cal-label">
          <div class="bcal__head">
            <button type="button" class="bcal__nav" data-cal-prev aria-label="Previous month">
              <span aria-hidden="true">&lsaquo;</span>
            </button>
            {/* The month title IS the jump control. The international window is two years, and
                paging that far one month at a time is the known failure mode of calendar pickers —
                but a separate jump widget would cost a row on a 380px screen. A native select
                solves both, and is the best possible mobile date-jump affordance. */}
            <label class="sr-only" for="bf-cal-jump">Jump to month</label>
            <select class="bcal__jump" id="bf-cal-jump" data-cal-jump></select>
            <button type="button" class="bcal__nav" data-cal-next aria-label="Next month">
              <span aria-hidden="true">&rsaquo;</span>
            </button>
          </div>
          <div class="bcal__dow" aria-hidden="true">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
          </div>
          <div class="bcal__grid" data-cal-grid></div>
          {/* Date preview. Opens on TAP and on KEYBOARD FOCUS — deliberately not hover, which does
              not exist on touch. Dismissable without a pointer: Escape closes it and leaves focus
              on the cell. Not a live region: the cell's own aria-label already announces the date,
              so making this one too would double-speak every arrow keypress. */}
          <div class="bpreview" data-cal-preview hidden>
            <div class="bpreview__body" data-preview-body></div>
            <div class="bpreview__actions">
              <button type="button" class="btn btn-primary bpreview__go" data-preview-select>Select this start date</button>
              <button type="button" class="blink bpreview__close" data-preview-close>Close</button>
            </div>
          </div>
          {/* aria-hidden because every cell already states its own status in its aria-label; the
              legend is a sighted-user convenience, not the accessible source of truth. */}
          <div class="bcal__legend" aria-hidden="true">
            <span class="bcal__key bcal__key--open">Open, start it</span>
            <span class="bcal__key bcal__key--started">Guaranteed departure, join it</span>
            <span class="bcal__key bcal__key--out">Unavailable</span>
          </div>
        </div>
        <p class="bcal__selected" data-cal-selected tabindex="-1" aria-live="polite"></p>
        <p class="bform__windowlimit" data-window-limit role="status" aria-live="polite" hidden></p>
      </div>

      {/* Sparse-availability helper: a short list of the soonest bookable departures, beneath the
          calendar, so a guest facing a mostly-grey month gets concrete options instead of paging.
          A few options is list territory; hundreds is grid territory — one component, both jobs. */}
      <div data-open-list>
        <p class="bstep__subheading">Soonest available</p>
        <div class="bjoin-list" data-join-list aria-live="polite"></div>
        <div class="bjoin-empty" data-join-empty hidden>
          <p class="bjoin-empty__lead">Nothing is open for this group yet.</p>
          <p class="bstep__hint">
            Tell us which months work and we'll let you know the moment a matching date opens, or
            <a href={site.contact.whatsappUrl} target="_blank" rel="noopener">ask us on WhatsApp</a>.
          </p>
          <div class="form-field">
            <label for="bf-notify-name">Name</label>
            <input id="bf-notify-name" type="text" maxlength="120" autocomplete="name" aria-describedby="bf-notify-name-err" />
            <span class="form-error" id="bf-notify-name-err" aria-live="polite"></span>
          </div>
          <div class="form-field">
            <label for="bf-notify-email">Email</label>
            <input id="bf-notify-email" type="email" maxlength="180" autocomplete="email" aria-describedby="bf-notify-email-err" />
            <span class="form-error" id="bf-notify-email-err" aria-live="polite"></span>
          </div>
          <div class="form-field">
            <label for="bf-notify-months">Which months work for you?</label>
            <span class="form-hint">e.g. September or October 2027, or flexible</span>
            <input id="bf-notify-months" type="text" maxlength="120" />
          </div>
          <div class="hp" aria-hidden="true">
            <label>Company<input id="bf-notify-company" tabindex="-1" autocomplete="off" /></label>
          </div>
          <button type="button" class="btn btn-secondary" data-notify-submit>Notify me</button>
          <p class="bform__status" data-notify-status role="status" aria-live="polite"></p>
        </div>
      </div>
      <p class="bstep__notice" data-step-notice role="status" aria-live="polite" hidden></p>
      <button type="button" class="btn btn-primary bstep__continue" data-step-continue>Continue</button>
    </div>
  </div>

  {/* ==== Step 3 — Your details. ============================================================== */}
  <div class="bstep" data-step="3">
    <div class="bstep__bar">
      <p class="bstep__heading" id="bf-details-label"><span class="bstep__num">3</span>. Your details</p>
      <p class="bstep__summary" data-step-summary hidden></p>
      <button type="button" class="blink bstep__edit" data-step-edit hidden>Edit</button>
    </div>
    <div class="bstep__body" data-step-body>
      <p class="bstep__sub" id="bf-details-label-sub">Who is the booking for?</p>
      <div class="bform__grid" aria-labelledby="bf-details-label-sub">
        <div class="form-field">
          <label for="bf-name">Lead guest name</label>
          <span class="form-hint">First and last name, e.g. Sarah van der Merwe</span>
          <input id="bf-name" name="leadName" type="text" autocomplete="name" maxlength="120" required aria-describedby="bf-name-err" />
          <span class="form-error" id="bf-name-err" aria-live="polite"></span>
        </div>
        <div class="form-field">
          <label for="bf-email">Email</label>
          <span class="form-hint">We'll send your booking confirmation here.</span>
          <input id="bf-email" name="leadEmail" type="email" autocomplete="email" maxlength="180" required aria-describedby="bf-email-err" />
          <span class="form-error" id="bf-email-err" aria-live="polite"></span>
        </div>
        <div class="form-field">
          <label for="bf-phone">Mobile number</label>
          <span class="form-hint">e.g. +27 82 123 4567, so we can reach you if needed</span>
          <input id="bf-phone" name="leadPhone" type="tel" autocomplete="tel" maxlength="40" required aria-describedby="bf-phone-err" />
          <span class="form-error" id="bf-phone-err" aria-live="polite"></span>
        </div>
      </div>

      {/* Honeypot — must stay empty */}
      <div class="hp" aria-hidden="true">
        <label>Company<input name="company" tabindex="-1" autocomplete="off" /></label>
      </div>
      <p class="bstep__notice" data-step-notice role="status" aria-live="polite" hidden></p>
      <button type="button" class="btn btn-primary bstep__continue" data-step-continue>Continue</button>
    </div>
  </div>

  {/* ==== Step 4 — Review and pay. ============================================================ */}
  <div class="bstep" data-step="4">
    <div class="bstep__bar">
      <p class="bstep__heading"><span class="bstep__num">4</span>. Review and pay</p>
    </div>
    <div class="bstep__body" data-step-body>
      {/* Trip shape at a glance: one line per night with its lodge and date, plus the departure
          day. Rendered from the chosen start date, so it is blank until a date exists. */}
      <div class="btrip" data-trip-summary hidden>
        <p class="btrip__title">Your trip</p>
        <ol class="btrip__nights" data-trip-nights></ol>
      </div>

      {/* Every figure is a NAMED line: the rate for that date, any last-minute reduction, the
          multiplication, then what is taken today. Rendered from the same helper as the date
          preview, so the card a guest reads before choosing and the one they pay from cannot
          disagree. */}
      <div class="bform__pricing">
        <div class="bform__breakdown" data-breakdown></div>
        <p class="bform__estimate">
          <span data-payment-label>Total:</span>
          <strong data-estimate>&mdash;</strong>
        </p>
        <p class="bstep__notice" data-lastminute-note role="status" aria-live="polite" hidden>
          Last-minute rate applied: {Math.round(LAST_MINUTE_DISCOUNT * 100)}% off for starts
          {LAST_MINUTE_MIN_DAYS} to {LAST_MINUTE_MAX_DAYS} days away.
        </p>
        <p class="bform__balance-note" data-balance-note hidden>
          Balance of <strong data-balance-amount></strong> due by <strong data-balance-date></strong>. We'll email a secure payment link.
        </p>
        <p class="bform__deposit-hint" data-deposit-hint>
          Departures {SPLIT_THRESHOLD_DAYS} or more days away pay a 50% deposit today, with the
          balance due {BALANCE_LEAD_DAYS} days before arrival. Inside that, the full amount is due
          at booking. Choose a start date to see your exact amounts.
        </p>
        <p class="bform__vat">All rates include VAT at 15% and all reserve conservation levies.</p>
      </div>

      <input id="bf-start" name="startDate" type="hidden" required />

      <button type="submit" class="btn btn-primary bform__submit" data-submit>Continue to secure payment</button>

      <p class="bform__status" data-status role="status" aria-live="polite"></p>
      <button type="button" class="btn btn-secondary bform__resume" data-resume-payment-btn hidden>Resume payment</button>

      {/* The fallback. Online booking cannot answer every question, and a guest who has a reason
          not to press the button should have somewhere to go other than away. Deliberately below
          the primary action, not beside it: it is an escape hatch, not a competing route. */}
      <p class="bform__fallback">
        Not sure which option fits, or need something the form cannot do?
        <a href={site.contact.whatsappUrl} target="_blank" rel="noopener">Message us on WhatsApp</a>
        or read <a href={withBase('/how-pricing-works')}>how pricing works</a>.
      </p>

      <p class="bform__privacy">
        By continuing you agree we may use your details to take and fulfil your booking. See our
        <a href="/privacy">Privacy Policy</a>, or
        <button type="button" class="blink" data-policy-open>view the cancellation policy</button>.
      </p>
    </div>
  </div>

  {/* The policy is read at the moment of hesitation, so it opens in place rather than navigating
      away from a part-completed form. A native <dialog> gives the focus trap, the Escape handler
      and the backdrop for free; no library, no focus-management code of our own to get wrong. */}
  <dialog class="bmodal" data-policy-modal aria-labelledby="bf-policy-title">
    <div class="bmodal__head">
      <h3 class="bmodal__title" id="bf-policy-title">Cancellation policy</h3>
      <button type="button" class="bmodal__close" data-policy-close aria-label="Close the cancellation policy">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div class="bmodal__body">
      <p class="bmodal__intro">{refundPolicy.intro}</p>
      <table class="bmodal__tiers">
        <caption class="sr-only">Refund by notice given before arrival</caption>
        <thead>
          <tr><th scope="col">Notice given</th><th scope="col">Refund</th></tr>
        </thead>
        <tbody>
          {refundPolicy.tiers.map((tier) => (
            <tr><td>{tier.window}</td><td>{tier.refund}</td></tr>
          ))}
        </tbody>
      </table>
      {refundPolicy.clauses.map((clause) => (
        <div class="bmodal__clause">
          <h4>{clause.heading}</h4>
          <p>{clause.body}</p>
        </div>
      ))}
    </div>
    <div class="bmodal__foot">
      <button type="button" class="btn btn-secondary" data-policy-close-foot>Close</button>
    </div>
  </dialog>
</form>

<script>
  import { actions } from 'astro:actions';

  // Anon, PUBLIC creds only (never the service-role key). `departure_inventory` is RLS-granted to
  // anon and exposes ONLY dates, seat and room counts and a catering label — no PII.
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  type Catering = 'catered' | 'uncatered';

  // Date helpers — UTC, ISO YYYY-MM-DD (mirror the server's lead-time/window/season rules).
  const pad = (n: number) => String(n).padStart(2, '0');
  const isoYMD = (y: number, m0: number, d: number) => `${y}-${pad(m0 + 1)}-${pad(d)}`;
  const addDaysIso = (iso: string, n: number) => {
    const dt = new Date(iso + 'T00:00:00Z');
    dt.setUTCDate(dt.getUTCDate() + n);
    return dt.toISOString().slice(0, 10);
  };
  const humanDate = (iso: string, opts: Intl.DateTimeFormatOptions) =>
    new Date(iso + 'T00:00:00Z').toLocaleDateString('en-ZA', { timeZone: 'UTC', ...opts });
  const daysBetween = (fromIso: string, toIso: string) =>
    Math.round((Date.parse(toIso + 'T00:00:00Z') - Date.parse(fromIso + 'T00:00:00Z')) / 86_400_000);
  // ISO day-of-week (Mon=1..Sun=7), matching Postgres isodow and lib/pricing.ts.
  const isoDow = (iso: string) => {
    const js = new Date(iso + 'T00:00:00Z').getUTCDay(); // 0=Sun..6=Sat
    return js === 0 ? 7 : js;
  };
  // High season: 1 April - 31 October, and 15 December - 15 January (wraps the year boundary).
  const isHighSeasonIso = (iso: string) => {
    const [, mStr, dStr] = iso.split('-');
    const mmdd = Number(mStr) * 100 + Number(dStr);
    if (mmdd >= 401 && mmdd <= 1031) return true;
    if (mmdd >= 1215 || mmdd <= 115) return true;
    return false;
  };

  // One record per start date that carries any state, straight from the derived
  // `departure_inventory` view (migration 0017).
  interface Departure {
    seatsTaken: number; // 0..8 — the guaranteed-departure line quotes this
    seatsLeft: number; // 0..8; forced to 0 on a blocked date
    roomsTaken: number; // 0..4 — a date fills on rooms
    lockedCatering: Catering | null; // null = nobody has opened this date
    isBlocked: boolean; // operator-blocked
  }

  // THE VIEW IS SPARSE. A date absent from the map has no state: nothing taken, all 8 places free,
  // no catering lock, not blocked. This is the one place that contract is applied — everything
  // downstream goes through departureFor() and never reads the map directly.
  const OPEN_DEPARTURE: Departure = {
    seatsTaken: 0,
    seatsLeft: 8,
    roomsTaken: 0,
    lockedCatering: null,
    isBlocked: false,
  };

  async function fetchInventory(): Promise<Map<string, Departure>> {
    const inv = new Map<string, Departure>();
    if (!SUPABASE_URL || !SUPABASE_ANON) return inv;
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/departure_inventory?select=start_date,seats_taken,seats_left,rooms_taken,locked_catering,is_blocked`,
        {
          headers: { apikey: SUPABASE_ANON, Authorization: `Bearer ${SUPABASE_ANON}` },
          cache: 'no-store', // always fresh — a cancellation must free the date immediately
        },
      );
      if (!res.ok) return inv;
      const rows = await res.json();
      if (Array.isArray(rows)) {
        for (const r of rows as {
          start_date: string;
          seats_taken: number;
          seats_left: number;
          rooms_taken: number;
          locked_catering: Catering | null;
          is_blocked: boolean;
        }[]) {
          if (!r?.start_date) continue;
          inv.set(r.start_date, {
            seatsTaken: r.seats_taken ?? 0,
            seatsLeft: r.seats_left,
            roomsTaken: r.rooms_taken ?? 0,
            lockedCatering: r.locked_catering ?? null,
            isBlocked: !!r.is_blocked,
          });
        }
      }
      return inv;
    } catch {
      return inv;
    }
  }

  function initBooking() {
    const form = document.getElementById('booking-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const R = JSON.parse(form.dataset.rates || '{}');
    const CATERING: Catering = R.catering === 'uncatered' ? 'uncatered' : 'catered';
    const CATERING_WORD = CATERING === 'catered' ? 'catered' : 'self-catered';

    // ---- DOM ---------------------------------------------------------------------------------
    const residencyBlock = form.querySelector<HTMLElement>('[data-residency-block]');
    const supplementEl = form.querySelector<HTMLElement>('[data-supplement]');
    const singleInput = form.querySelector<HTMLInputElement>('[data-count-input="single"]');
    const sadcInput = form.querySelector<HTMLInputElement>('[data-count-input="sadc"]');
    const residencyDeclare = form.querySelector<HTMLInputElement>('[data-residency-declare]');
    const residencyError = form.querySelector<HTMLElement>('[data-residency-error]');
    const ageConfirm = form.querySelector<HTMLInputElement>('[data-age-confirm]');
    const ageError = form.querySelector<HTMLElement>('[data-age-error]');

    const joinList = form.querySelector<HTMLElement>('[data-join-list]');
    const joinEmpty = form.querySelector<HTMLElement>('[data-join-empty]');
    const notifyName = form.querySelector<HTMLInputElement>('#bf-notify-name');
    const notifyEmail = form.querySelector<HTMLInputElement>('#bf-notify-email');
    const notifyMonths = form.querySelector<HTMLInputElement>('#bf-notify-months');
    const notifyCompany = form.querySelector<HTMLInputElement>('#bf-notify-company');
    const notifySubmit = form.querySelector<HTMLButtonElement>('[data-notify-submit]');
    const notifyStatus = form.querySelector<HTMLElement>('[data-notify-status]');

    const cal = form.querySelector<HTMLElement>('[data-calendar]');
    const calGrid = cal?.querySelector<HTMLElement>('[data-cal-grid]') ?? null;
    const calPrevBtn = cal?.querySelector<HTMLButtonElement>('[data-cal-prev]') ?? null;
    const calNextBtn = cal?.querySelector<HTMLButtonElement>('[data-cal-next]') ?? null;
    const calJump = cal?.querySelector<HTMLSelectElement>('[data-cal-jump]') ?? null;
    const previewEl = cal?.querySelector<HTMLElement>('[data-cal-preview]') ?? null;
    const previewBody = cal?.querySelector<HTMLElement>('[data-preview-body]') ?? null;
    const previewSelectBtn = cal?.querySelector<HTMLButtonElement>('[data-preview-select]') ?? null;
    const previewCloseBtn = cal?.querySelector<HTMLButtonElement>('[data-preview-close]') ?? null;
    const calField = cal?.closest<HTMLElement>('.bform__datefield') ?? null;
    const calNextAvailEl = calField?.querySelector<HTMLElement>('[data-nextavail]') ?? null;
    const calSelectedEl = calField?.querySelector<HTMLElement>('[data-cal-selected]') ?? null;
    const calWindowLimitEl = calField?.querySelector<HTMLElement>('[data-window-limit]') ?? null;
    cal?.classList.add('bcal--shared'); // taller cells, matching the seat-count states

    const breakdownEl = form.querySelector<HTMLElement>('[data-breakdown]');
    const estimate = form.querySelector<HTMLElement>('[data-estimate]');
    const paymentLabel = form.querySelector<HTMLElement>('[data-payment-label]');
    const lastMinuteNote = form.querySelector<HTMLElement>('[data-lastminute-note]');
    const balanceNote = form.querySelector<HTMLElement>('[data-balance-note]');
    const balanceAmt = form.querySelector<HTMLElement>('[data-balance-amount]');
    const balanceDate = form.querySelector<HTMLElement>('[data-balance-date]');
    const depositHint = form.querySelector<HTMLElement>('[data-deposit-hint]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const resumeBtn = form.querySelector<HTMLButtonElement>('[data-resume-payment-btn]');
    const startInput = form.querySelector<HTMLInputElement>('#bf-start');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const nameInput = form.querySelector<HTMLInputElement>('#bf-name')!;
    const emailInput = form.querySelector<HTMLInputElement>('#bf-email')!;
    const phoneInput = form.querySelector<HTMLInputElement>('#bf-phone')!;

    const fmtR = (cents: number) => 'R' + Math.round(cents / 100).toLocaleString('en-US');
    // SAST (UTC+2, no DST), matching the server's todaySast() in lib/pricing.ts exactly — NOT
    // toISOString(), which is UTC and runs a calendar day behind between 00:00-02:00 SAST. This is
    // display-only (the server is the price authority), but a UTC "today" could show a different
    // last-minute or deposit-split classification here than createCheckout charges seconds later.
    const todayIso = new Date().toLocaleDateString('en-CA', { timeZone: 'Africa/Johannesburg' });

    // ---- State -------------------------------------------------------------------------------
    // Everything that changes the price or the calendar is answered in step 1 and read back off
    // the form, so there is one source for each value: the radios and the two hidden inputs.
    let selectedStartIso = '';

    let inventory = new Map<string, Departure>();
    let availabilityInFlight: Promise<void> | null = null;

    // Resolves any date to a Departure, applying the sparse-view contract.
    function departureFor(iso: string): Departure {
      return inventory.get(iso) ?? OPEN_DEPARTURE;
    }

    // Fetches the view once and swaps the map. Concurrent callers (a rapid group-size change while
    // a fetch is in flight) share the one request rather than firing a second.
    function loadAvailability(): Promise<void> {
      if (!availabilityInFlight) {
        availabilityInFlight = fetchInventory()
          .then((inv) => { inventory = inv; })
          .finally(() => { availabilityInFlight = null; });
      }
      return availabilityInFlight;
    }

    async function syncAvailability(): Promise<void> {
      await loadAvailability();
      calRefresh();
      joinRefresh();
    }

    // ---- Price math mirrored from lib/pricing.ts (display only; the server recomputes) --------
    // Same order, same flooring: base -> rate year -> season -> SADC -> last-minute -> floor.
    // Flooring once at the end is what makes 12,720 x 1.08 read R13,737, matching the rate table.
    function rateYearFor(iso: string): number {
      const y = Number(iso.slice(0, 4));
      return R.yearMultipliers[String(y)] !== undefined ? y : R.lastYear;
    }

    function withinLastMinuteWindow(iso: string): boolean {
      const gap = daysBetween(todayIso, iso);
      return gap >= R.lastMinuteMinDays && gap <= R.lastMinuteMaxDays;
    }

    // Per person, whole trip, in cents, exactly as lib/pricing.ts resolves it: base -> rate year ->
    // season -> SADC (catered) -> last-minute -> floor to the rand.
    type Band = 'international' | 'sadc';
    function ppTripCents(iso: string, band: Band, withLastMinute = true): number {
      let rand = R.baseRate * (R.yearMultipliers[String(rateYearFor(iso))] ?? 1);
      if (!isHighSeasonIso(iso)) rand *= 1 - R.seasonDiscount;
      if (band === 'sadc') rand *= 1 - R.sadcDiscount;
      if (withLastMinute && withinLastMinuteWindow(iso)) rand *= 1 - R.lastMinuteDiscount;
      return Math.floor(rand) * 100;
    }

    // Single supplement per own room: 40% of that date's international rate, floored. 0 for
    // self-catered.
    function supplementCents(iso: string, withLastMinute = true): number {
      if (!R.supplementPct) return 0;
      return Math.floor((ppTripCents(iso, 'international', withLastMinute) / 100) * R.supplementPct / 100) * 100;
    }

    // The booking's price lines for one date, all counts read from step 1. `before` is the same
    // total without the last-minute reduction, so that reduction can be shown as its own line.
    interface Priced {
      intl: number; sadc: number; singles: number;
      intlPp: number; sadcPp: number; supp: number;
      before: number; total: number;
    }
    function priceFor(iso: string): Priced {
      const n = groupSize();
      const sadc = sadcCount();
      const singles = singleRooms();
      const intl = n - sadc;
      const sum = (lm: boolean) =>
        intl * ppTripCents(iso, 'international', lm) + sadc * ppTripCents(iso, 'sadc', lm) + singles * supplementCents(iso, lm);
      return {
        intl, sadc, singles,
        intlPp: ppTripCents(iso, 'international', false),
        sadcPp: ppTripCents(iso, 'sadc', false),
        supp: supplementCents(iso, false),
        before: sum(false),
        total: sum(true),
      };
    }

    // ---- Field validation --------------------------------------------------------------------
    type Rule = (v: string) => string | null;

    function firstErr(val: string, rules: Rule[]): string | null {
      for (const r of rules) { const e = r(val); if (e) return e; }
      return null;
    }

    function markField(wrapper: Element | null, msg: string | null): void {
      if (!wrapper) return;
      const errEl = wrapper.querySelector<HTMLElement>('.form-error');
      wrapper.classList.toggle('has-error', !!msg);
      if (errEl) errEl.textContent = msg ?? '';
    }

    function bindField(input: HTMLInputElement, rules: Rule[]): void {
      const wrapper = input.closest('.form-field');
      input.addEventListener('blur', () => markField(wrapper, firstErr(input.value, rules)));
      input.addEventListener('input', () => {
        if (wrapper?.classList.contains('has-error')) markField(wrapper, firstErr(input.value, rules));
      });
    }

    const nameRules: Rule[] = [
      v => !v.trim()           ? 'Please enter your full name.'                  : null,
      v => v.trim().length < 2 ? 'Name must be at least 2 characters.'           : null,
    ];
    const emailRules: Rule[] = [
      v => !v.trim()           ? 'Please enter your email address.'              : null,
      v => !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())
                               ? "That doesn't look like a valid email address." : null,
    ];
    const phoneRules: Rule[] = [
      v => !v.trim()                              ? 'Please enter a mobile number.'      : null,
      v => v.trim().replace(/[\s\-()]/g, '').length < 7
                                                  ? 'Please enter a valid phone number.' : null,
    ];

    bindField(nameInput, nameRules);
    bindField(emailInput, emailRules);
    bindField(phoneInput, phoneRules);
    if (notifyName) bindField(notifyName, nameRules);
    if (notifyEmail) bindField(notifyEmail, emailRules);

    function groupSize(): number {
      const checked = form!.querySelector<HTMLInputElement>('input[name="groupSize"]:checked');
      if (checked) return Number(checked.value);
      const fixed = form!.querySelector<HTMLInputElement>('input[name="groupSize"]');
      return Number(fixed?.value || R.partyMin);
    }

    function singleRooms(): number {
      return Number(singleInput?.value || 0);
    }

    function sadcCount(): number {
      return Number(sadcInput?.value || 0);
    }

    // Rooms this party uses: everyone not in their own room shares a double within the booking.
    function myRooms(): number {
      return singleRooms() + (groupSize() - singleRooms()) / 2;
    }

    // 12 months as soon as anyone is counted as SADC (always, self-catered), otherwise 24.
    function latestFor(): string {
      return sadcCount() > 0 ? R.latestSadc : R.latestIntl;
    }

    function monthsFor(): number {
      return sadcCount() > 0 ? R.monthsSadc : R.monthsIntl;
    }

    // Tapered start: Tuesday, Wednesday and Saturday are not start days up to R.taperEnd.
    function isTaperBlocked(iso: string): boolean {
      if (iso > R.taperEnd) return false;
      return (R.taperDows as number[]).includes(isoDow(iso));
    }

    // Each step has its own notice line, so a message always appears in the step the guest is on.
    function stepNotice(n: number): HTMLElement | null {
      return form!.querySelector<HTMLElement>(`.bstep[data-step="${n}"] [data-step-notice]`);
    }
    function showPathNotice(msg: string, n = currentStep) {
      const el = stepNotice(n);
      if (!el) return;
      el.textContent = msg;
      el.hidden = false;
    }
    function hidePathNotice() {
      form!.querySelectorAll<HTMLElement>('[data-step-notice]').forEach((el) => {
        el.textContent = '';
        el.hidden = true;
      });
    }

    // ---- Cell classification -----------------------------------------------------------------
    // open:           nobody has started this date and this party can open it.
    // joinable:       already running, matching catering, enough rooms for this party.
    // cateringLocked: held by a departure this guest cannot join. Kept as its own STATE because
    //   the reason differs from "full" and data-state is useful when debugging, but it is drawn
    //   and described exactly like any other unavailable date: each mount sells one product, and
    //   naming the other one would advertise a product this page does not sell.
    // full:           running and matching, but not enough rooms for this party. Rooms are always
    //                 the binding limit: a party fitting the free rooms always fits the walkers.
    // needsOpen:      nobody has started it and this party is below the opening minimum (for a
    //                 solo walker: single walkers can only join a guaranteed departure).
    // closed:         blocked, not a start day, too soon, or beyond the window. Always says which.
    type CellState = 'open' | 'joinable' | 'cateringLocked' | 'full' | 'needsOpen' | 'closed';
    type ClosedReason = 'blocked' | 'taperDay' | 'tooSoon' | 'outOfWindow';
    interface Classification {
      state: CellState;
      seatsTaken: number;
      seatsLeft: number;
      roomsLeft: number;
      lockedCatering?: Catering | null;
      reason?: ClosedReason;
    }

    function classifyDate(iso: string): Classification {
      const d = departureFor(iso);
      const roomsLeft = d.isBlocked ? 0 : Math.max(0, R.rooms - d.roomsTaken);
      const base = { seatsTaken: d.seatsTaken, seatsLeft: d.seatsLeft, roomsLeft, lockedCatering: d.lockedCatering };
      if (d.isBlocked) return { ...base, state: 'closed', reason: 'blocked' };
      if (isTaperBlocked(iso)) return { ...base, state: 'closed', reason: 'taperDay' };
      if (iso < R.earliest) return { ...base, state: 'closed', reason: 'tooSoon' };
      if (iso > latestFor()) return { ...base, state: 'closed', reason: 'outOfWindow' };

      const n = groupSize();
      if (d.seatsTaken === 0) {
        return n >= R.partyMin ? { ...base, state: 'open' } : { ...base, state: 'needsOpen' };
      }
      if (d.lockedCatering && d.lockedCatering !== CATERING) {
        return { ...base, state: 'cateringLocked' };
      }
      if (n < R.joinMin) return { ...base, state: 'needsOpen' };
      return myRooms() <= roomsLeft && n <= d.seatsLeft
        ? { ...base, state: 'joinable' }
        : { ...base, state: 'full' };
    }

    // Six logical states, three appearances: `open` and `joinable` are both actionable but read
    // differently (nobody there yet, versus a departure already guaranteed to run); everything a
    // guest cannot book looks the same, whatever the reason, with the reason in the aria-label.
    type CellVisual = 'open' | 'started' | 'unavailable';
    function visualFor(c: Classification): CellVisual {
      if (c.state === 'open') return 'open';
      if (c.state === 'joinable') return 'started';
      return 'unavailable';
    }

    const actionable = (c: Classification) => c.state === 'open' || c.state === 'joinable';

    // The memo's exact wording, shown the moment a date has a booking on it. "Available" counts
    // the free rooms as doubles, because a new party can only use a free room.
    function guaranteedLine(c: Classification): string {
      return `Guaranteed Departure: ${c.seatsTaken} of ${R.maxGroup} spots booked. ${2 * c.roomsLeft} spots available.`;
    }

    function lastMinuteSpoken(): string {
      return `, last-minute rate, ${Math.round(R.lastMinuteDiscount * 100)}% less`;
    }

    function cellReasonText(c: Classification): string {
      if (c.state === 'needsOpen') {
        if (c.seatsTaken > 0) return `already running, joining takes at least ${R.joinMin} walkers`;
        return groupSize() === 1
          ? 'single walkers can join a guaranteed departure'
          : `needs ${R.partyMin} or more walkers to open`;
      }
      if (c.state === 'full') return `only ${c.roomsLeft} room(s) left, your group needs ${myRooms()}`;
      if (c.state === 'cateringLocked') return 'already taken by another group';
      if (c.reason === 'blocked') return 'not running that week';
      if (c.reason === 'taperDay') return `not a start day: departures run ${R.startDays} until ${R.taperEndDisplay}`;
      if (c.reason === 'tooSoon') return 'too close to departure to book online';
      return 'beyond the dates open for booking';
    }

    // ---- Date preview ------------------------------------------------------------------------
    function previewRow(label: string, value: string, mod = ''): HTMLElement {
      const row = document.createElement('p');
      row.className = 'bpreview__row' + (mod ? ` bpreview__row--${mod}` : '');
      const l = document.createElement('span');
      l.className = 'bpreview__label';
      l.textContent = label;
      const v = document.createElement('span');
      v.className = 'bpreview__value';
      v.textContent = value;
      row.append(l, v);
      return row;
    }

    // The named price lines for one date, used by BOTH the preview card and the review step, so
    // the figure a guest reads before choosing and the one they pay from are one computation.
    // One line per rate that applies, then any last-minute reduction, then the total. Used by the
    // date preview AND the review step, so the figure a guest reads before choosing a date and the
    // one they pay from are one computation. Each line reads "count x rate" at the date's rate
    // before the last-minute reduction; that reduction is its own named line.
    function priceRows(iso: string, n: number): HTMLElement[] {
      const rows: HTMLElement[] = [];
      const p = priceFor(iso);
      // Only the hidden page's mount says "self-catered"; the public mount never names it.
      const rateName = CATERING === 'catered' ? 'All-inclusive rate' : 'Self-catered rate';
      if (CATERING === 'uncatered') {
        rows.push(previewRow(`${rateName}, ${n} x ${fmtR(p.sadcPp)}`, fmtR(n * p.sadcPp)));
      } else {
        if (p.intl > 0) rows.push(previewRow(`${rateName}, ${p.intl} x ${fmtR(p.intlPp)}`, fmtR(p.intl * p.intlPp)));
        if (p.sadc > 0) {
          rows.push(previewRow(
            `SADC resident rate (${R.sadcPercent}% off), ${p.sadc} x ${fmtR(p.sadcPp)}`,
            fmtR(p.sadc * p.sadcPp)));
        }
        if (p.singles > 0) rows.push(previewRow(`Single supplement, ${p.singles} x ${fmtR(p.supp)}`, fmtR(p.singles * p.supp)));
      }
      // The last-minute reduction IS named: every guest can qualify for it, it is visible on the
      // calendar, and an unexplained drop in the total is worse than naming it.
      if (p.total < p.before) {
        rows.push(previewRow(
          `Last-minute, ${Math.round(R.lastMinuteDiscount * 100)}% less`,
          `- ${fmtR(p.before - p.total)}`, 'credit'));
      }
      rows.push(previewRow(`Total, ${n} ${n === 1 ? 'walker' : 'walkers'}`, fmtR(p.total), 'total'));
      return rows;
    }

    let previewDismissedIso = '';

    function renderPreview(iso: string) {
      if (!previewBody || !previewEl) return;
      const c = classifyDate(iso);
      const n = groupSize();
      previewBody.textContent = '';

      const date = document.createElement('p');
      date.className = 'bpreview__date';
      date.textContent = humanDate(iso, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      previewBody.appendChild(date);

      const tags = document.createElement('p');
      tags.className = 'bpreview__tags';
      const tag = (text: string, mod = '') => {
        const s = document.createElement('span');
        s.className = 'bpreview__tag' + (mod ? ` bpreview__tag--${mod}` : '');
        s.textContent = text;
        tags.appendChild(s);
      };
      tag(isHighSeasonIso(iso) ? 'High season' : 'Low season');
      if (withinLastMinuteWindow(iso)) tag('Last-minute rate', 'lm');
      if (c.seatsTaken === 0 && myRooms() >= R.rooms) tag('Exclusive use', 'excl');
      previewBody.appendChild(tags);

      if (c.seatsTaken > 0) {
        const places = document.createElement('p');
        places.className = 'bpreview__places';
        places.textContent = guaranteedLine(c);
        previewBody.appendChild(places);
      }

      if (actionable(c)) {
        for (const row of priceRows(iso, n)) previewBody.appendChild(row);
      } else {
        const note = document.createElement('p');
        note.className = 'bpreview__note';
        note.textContent = cellReasonText(c);
        previewBody.appendChild(note);
      }

      if (previewSelectBtn) previewSelectBtn.hidden = !actionable(c);
    }

    function openPreview(iso: string) {
      if (!previewEl || previewDismissedIso === iso) return;
      renderPreview(iso);
      previewEl.hidden = false;
      previewEl.dataset.iso = iso;
    }

    function closePreview(dismiss = false) {
      if (!previewEl) return;
      if (dismiss) previewDismissedIso = previewEl.dataset.iso ?? '';
      previewEl.hidden = true;
    }

    previewCloseBtn?.addEventListener('click', () => closePreview(true));
    previewSelectBtn?.addEventListener('click', () => {
      const iso = previewEl?.dataset.iso;
      if (iso) calSelectDate(iso);
    });

    // ---- Selection ---------------------------------------------------------------------------
    function calClearSelection() {
      calSelected = '';
      selectedStartIso = '';
      if (startInput) startInput.value = '';
      if (calSelectedEl) calSelectedEl.textContent = '';
    }

    function calSelectDate(iso: string) {
      const c = classifyDate(iso);
      if (!actionable(c)) return;
      calSelected = iso;
      selectedStartIso = iso;
      if (startInput) startInput.value = iso;
      closePreview();
      if (calSelectedEl) {
        const human = humanDate(iso, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        calSelectedEl.textContent =
          c.seatsTaken > 0
            ? `${human}. ${guaranteedLine(c)}`
            : myRooms() >= R.rooms
              ? `${human}. You are taking all ${R.rooms} rooms, so the trail is yours alone.`
              : `${human}. You are opening this departure.`;
      }
      calRender();
      updateEstimate();
      goToStep(3);
    }

    // ---- Soonest-available list --------------------------------------------------------------
    interface JoinRow { iso: string; c: Classification; }

    function renderJoinList(rows: JoinRow[]) {
      if (!joinList || !joinEmpty) return;
      joinList.textContent = '';
      joinEmpty.hidden = rows.length > 0;
      for (const { iso, c } of rows) {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'bjoin-card';
        const body = document.createElement('span');
        body.className = 'bjoin-card__body';
        const date = document.createElement('span');
        date.className = 'bjoin-card__date';
        date.textContent = humanDate(iso, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        const meta = document.createElement('span');
        meta.className = 'bjoin-card__meta';
        meta.textContent = c.seatsTaken > 0 ? guaranteedLine(c) : 'Open, nobody has started it';
        body.append(date, meta);
        card.appendChild(body);
        const price = document.createElement('span');
        price.className = 'bjoin-card__price';
        price.textContent = `${fmtR(priceFor(iso).total)} total`;
        card.appendChild(price);
        card.addEventListener('click', () => calSelectDate(iso));
        joinList.appendChild(card);
      }
    }

    // Walks forward from the earliest bookable date and returns the first few actionable ones.
    function joinRefresh() {
      const rows: JoinRow[] = [];
      const limit = latestFor();
      let iso = R.earliest > todayIso ? R.earliest : todayIso;
      let guard = 0;
      while (iso <= limit && rows.length < 3 && guard < 800) {
        const c = classifyDate(iso);
        if (actionable(c)) rows.push({ iso, c });
        iso = addDaysIso(iso, 1);
        guard++;
      }
      renderJoinList(rows);
    }

    // ---- Estimate ----------------------------------------------------------------------------
    function paintEstimate() {
      const n = groupSize();
      if (lastMinuteNote) lastMinuteNote.hidden = true;
      if (breakdownEl) breakdownEl.textContent = '';

      if (!selectedStartIso) {
        if (estimate) estimate.textContent = '—';
        if (paymentLabel) paymentLabel.textContent = 'Total:';
        if (balanceNote) balanceNote.hidden = true;
        if (depositHint) depositHint.hidden = false;
        if (submit) submit.textContent = 'Continue to secure payment';
        return;
      }

      const totalCents = priceFor(selectedStartIso).total;

      // Never one unexplained figure: the same priceRows() the date card uses.
      if (breakdownEl) {
        for (const row of priceRows(selectedStartIso, n)) breakdownEl.appendChild(row);
      }
      if (lastMinuteNote) lastMinuteNote.hidden = !withinLastMinuteWindow(selectedStartIso);
      if (estimate) estimate.textContent = fmtR(totalCents);

      const isDeposit = daysBetween(todayIso, selectedStartIso) >= R.splitDays;
      const depositCents = isDeposit ? Math.round(totalCents / 2) : totalCents;
      const balanceCents = isDeposit ? totalCents - depositCents : 0;

      if (isDeposit) {
        if (paymentLabel) paymentLabel.textContent = 'Pay today (50% deposit):';
        if (estimate) estimate.textContent = fmtR(depositCents);
        if (balanceNote) {
          balanceNote.hidden = false;
          if (balanceAmt) balanceAmt.textContent = fmtR(balanceCents);
          if (balanceDate) {
            const dueIso = addDaysIso(selectedStartIso, -R.balanceLeadDays);
            balanceDate.textContent = humanDate(dueIso, { day: 'numeric', month: 'long', year: 'numeric' });
          }
        }
        if (depositHint) depositHint.hidden = true;
        if (submit) submit.textContent = 'Pay deposit & continue to checkout';
      } else {
        if (paymentLabel) paymentLabel.textContent = 'Pay in full today:';
        if (balanceNote) balanceNote.hidden = true;
        if (depositHint) depositHint.hidden = true;
        if (submit) submit.textContent = 'Continue to secure payment';
      }
    }

    function updateEstimate() {
      paintEstimate();
      paintSupplement();
      refreshSteps();
    }

    // ---- Guided accordion (4 steps) ----------------------------------------------------------
    // The markup ships with every step open and unclassed. Everything below is additive: the
    // `bform--stepped` class switches the collapse CSS on, so if this script throws before that
    // line the guest still gets the full long-scroll form rather than a stuck one.
    //
    // State is derived, never stored twice: completeness is recomputed from the same variables the
    // submit handler reads, so a step cannot show a tick while the value behind it is missing.
    const stepEls = Array.from(form.querySelectorAll<HTMLElement>('.bstep[data-step]'));
    const LAST_STEP = stepEls.length;
    const tripSummary = form.querySelector<HTMLElement>('[data-trip-summary]');
    const tripNights = form.querySelector<HTMLElement>('[data-trip-nights]');
    let currentStep = 1;
    const stepEl = (n: number) => stepEls.find((el) => el.dataset.step === String(n)) ?? null;

    function detailsValid(): boolean {
      return (
        !firstErr(nameInput.value, nameRules) &&
        !firstErr(emailInput.value, emailRules) &&
        !firstErr(phoneInput.value, phoneRules)
      );
    }

    // The SADC tick is needed whenever anyone is counted as SADC (always, self-catered).
    function residencyValid(): boolean {
      return sadcCount() === 0 || !!residencyDeclare?.checked;
    }

    function stepComplete(n: number): boolean {
      if (n === 1) return !!ageConfirm?.checked && residencyValid();
      if (n === 2) return !!selectedStartIso;
      if (n === 3) return detailsValid();
      return true;
    }

    // One short line per collapsed step: enough to confirm the choice without reopening it.
    // Step 1 reads "3 walkers · 1 own room · 2 SADC residents", leaving out any part that is 0.
    function stepSummaryText(n: number): string {
      if (n === 1) {
        const g = groupSize();
        const singles = singleRooms();
        const sadc = sadcCount();
        return [
          `${g} ${g === 1 ? 'walker' : 'walkers'}`,
          singles > 0 ? `${singles} own ${singles === 1 ? 'room' : 'rooms'}` : '',
          sadc > 0 ? `${sadc} SADC ${sadc === 1 ? 'resident' : 'residents'}` : '',
        ].filter(Boolean).join(' · ');
      }
      if (n === 2) {
        if (!selectedStartIso) return '';
        return humanDate(selectedStartIso, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
      }
      if (n === 3) return [nameInput.value.trim(), emailInput.value.trim()].filter(Boolean).join(' · ');
      return '';
    }

    // Night N is spent at nightLodges[N-1] and starts on startDate + (N-1); the trip ends the
    // morning after the last night. Built with createElement/textContent, never innerHTML.
    function renderTripSummary(): void {
      if (!tripSummary || !tripNights) return;
      const lodges: string[] = Array.isArray(R.nightLodges) ? R.nightLodges.slice(0, R.nights) : [];
      if (!selectedStartIso || lodges.length === 0) {
        tripSummary.hidden = true;
        return;
      }
      tripNights.textContent = '';
      const row = (label: string, iso: string, where: string, depart = false) => {
        const li = document.createElement('li');
        if (depart) li.className = 'btrip__depart';
        const l = document.createElement('span');
        l.className = 'btrip__label';
        l.textContent = label;
        const d = document.createElement('span');
        d.className = 'btrip__date';
        d.textContent = humanDate(iso, { weekday: 'short', day: 'numeric', month: 'short' });
        const w = document.createElement('span');
        w.className = 'btrip__where';
        w.textContent = where;
        li.append(l, d, w);
        tripNights.appendChild(li);
      };
      lodges.forEach((lodge, i) => row(`Night ${i + 1}`, addDaysIso(selectedStartIso, i), lodge));
      row('Depart', addDaysIso(selectedStartIso, lodges.length), `After the final walk back to ${R.departureLodge}`, true);
      tripSummary.hidden = false;
    }

    function refreshSteps(): void {
      for (const el of stepEls) {
        const n = Number(el.dataset.step);
        const done = n < currentStep && stepComplete(n);
        el.classList.toggle('is-current', n === currentStep);
        el.classList.toggle('is-done', done);
        el.classList.toggle('is-locked', n > currentStep);

        const sum = el.querySelector<HTMLElement>('[data-step-summary]');
        const edit = el.querySelector<HTMLButtonElement>('[data-step-edit]');
        const text = done ? stepSummaryText(n) : '';
        if (sum) {
          sum.textContent = text;
          sum.hidden = !text;
        }
        if (edit) edit.hidden = !done;
      }
      renderTripSummary();
    }

    // `reveal` is false for the initial call only: moving focus and scrolling on load would yank
    // the visitor down to the widget before they asked for it. Every later move is guest-initiated
    // and SHOULD take focus, so keyboard and screen-reader users land on the step that opened.
    function goToStep(n: number, reveal = true): void {
      currentStep = Math.min(Math.max(n, 1), LAST_STEP);
      refreshSteps();
      if (!reveal) return;
      const el = stepEl(currentStep);
      const heading = el?.querySelector<HTMLElement>('.bstep__heading');
      if (heading) {
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
      }
      el?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Continue: block the advance and say why, rather than moving on to a step that cannot be
    // completed. The messages name the missing thing; they never just refuse.
    const BLOCKED: Record<number, string> = {
      2: 'Choose a start date to continue.',
      3: 'Please complete your details to continue.',
    };
    for (const el of stepEls) {
      const n = Number(el.dataset.step);
      el.querySelector<HTMLButtonElement>('[data-step-continue]')?.addEventListener('click', () => {
        if (!stepComplete(n)) {
          if (n === 1 && !ageConfirm?.checked) {
            if (ageError) ageError.textContent = 'Please tick the age confirmation to continue.';
            ageConfirm?.focus();
            return;
          }
          if (n === 1 && !residencyValid()) {
            if (residencyError) residencyError.textContent = 'Please tick the SADC confirmation to continue.';
            residencyDeclare?.focus();
            return;
          }
          if (n === 3) {
            markField(nameInput.closest('.form-field'), firstErr(nameInput.value, nameRules));
            markField(emailInput.closest('.form-field'), firstErr(emailInput.value, emailRules));
            markField(phoneInput.closest('.form-field'), firstErr(phoneInput.value, phoneRules));
          }
          showPathNotice(BLOCKED[n] ?? 'Please complete this step to continue.', n);
          return;
        }
        hidePathNotice();
        goToStep(n + 1);
      });
      el.querySelector<HTMLButtonElement>('[data-step-edit]')?.addEventListener('click', () => goToStep(n));
    }

    for (const input of [nameInput, emailInput, phoneInput]) {
      input.addEventListener('input', refreshSteps);
    }

    form.classList.add('bform--stepped');

    // ---- Calendar ----------------------------------------------------------------------------
    const viewIdx = (y: number, m: number) => y * 12 + m;
    const calMinIdx = viewIdx(+R.earliest.slice(0, 4), +R.earliest.slice(5, 7) - 1);
    let calSelected = '';
    let calFocusIso = ''; // the grid's single roving tab stop
    let calLatest: string = latestFor();
    let calMaxIdx = viewIdx(+calLatest.slice(0, 4), +calLatest.slice(5, 7) - 1);
    // Default to the first bookable month, not the calendar month — nobody should have to page
    // past months that cannot be booked yet.
    let calView = { y: +R.earliest.slice(0, 4), m: +R.earliest.slice(5, 7) - 1 };

    function calRender() {
      if (!calGrid || !calPrevBtn || !calNextBtn) return;
      calPrevBtn.disabled = viewIdx(calView.y, calView.m) <= calMinIdx;
      const atMaxMonth = viewIdx(calView.y, calView.m) >= calMaxIdx;
      calNextBtn.disabled = atMaxMonth;
      calGrid.textContent = '';
      const firstDow = new Date(Date.UTC(calView.y, calView.m, 1)).getUTCDay(); // 0=Sun
      const lead = (firstDow + 6) % 7; // Monday-first
      for (let i = 0; i < lead; i++) {
        const blank = document.createElement('span');
        blank.className = 'bcal__cell bcal__cell--blank';
        calGrid.appendChild(blank);
      }
      const days = new Date(Date.UTC(calView.y, calView.m + 1, 0)).getUTCDate();
      for (let day = 1; day <= days; day++) {
        const iso = isoYMD(calView.y, calView.m, day);
        const c = classifyDate(iso);
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.dataset.iso = iso;
        // Roving tabindex: the grid is ONE tab stop, so Tab from the focused cell reaches the
        // preview's Select button instead of walking 30 more days. Arrow keys move within it.
        cell.tabIndex = iso === calFocusIso ? 0 : -1;
        cell.className = `bcal__cell bcal__cell--${visualFor(c)}`;
        cell.dataset.state = c.state;
        const human = humanDate(iso, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        const dayNum = document.createElement('span');
        dayNum.className = 'bcal__daynum';
        dayNum.textContent = String(day);
        cell.appendChild(dayNum);

        if (actionable(c)) {
          const priceWord = `, ${fmtR(priceFor(iso).total)} for your group`;
          const what =
            c.seatsTaken > 0
              ? `, guaranteed departure, ${c.seatsTaken} of ${R.maxGroup} places booked, ${2 * c.roomsLeft} available`
              : myRooms() >= R.rooms
                ? ', open, and your group takes every room'
                : ', open, nobody has started it';
          const lm = withinLastMinuteWindow(iso) ? lastMinuteSpoken() : '';
          cell.setAttribute('aria-label', `${human}${what}${priceWord}${lm}`);
          cell.setAttribute('aria-pressed', iso === calSelected ? 'true' : 'false');
          if (iso === calSelected) cell.classList.add('is-selected');
          cell.addEventListener('click', () => { previewDismissedIso = ''; openPreview(iso); });
        } else {
          // aria-disabled, deliberately NOT the disabled attribute: a disabled button cannot take
          // focus, which would make the reason unreadable for a keyboard user. It has no click
          // handler, so it is inert either way.
          cell.classList.add('is-inert');
          cell.setAttribute('aria-label', `${human}, ${cellReasonText(c)}`);
          cell.setAttribute('aria-disabled', 'true');
        }
        cell.addEventListener('focus', () => {
          calFocusIso = iso;
          openPreview(iso);
        });
        calGrid.appendChild(cell);
      }
      // If the roving stop is not in this month (month or filter change), park it on the first
      // cell so the grid is always reachable by Tab.
      if (!calGrid.querySelector('[tabindex="0"]')) {
        const first = calGrid.querySelector<HTMLButtonElement>('.bcal__cell:not(.bcal__cell--blank)');
        if (first) { first.tabIndex = 0; calFocusIso = first.dataset.iso ?? ''; }
      }

      if (calJump) {
        const wantOpts = calMaxIdx - calMinIdx + 1;
        if (calJump.options.length !== wantOpts) buildJump();
        calJump.value = String(viewIdx(calView.y, calView.m));
      }

      // Window-ceiling label — the last navigable month explains the boundary rather than just
      // disabling the "next" arrow with no reason.
      if (calWindowLimitEl) {
        if (atMaxMonth) {
          calWindowLimitEl.hidden = false;
          calWindowLimitEl.textContent =
            `This is as far ahead as bookings open: ${monthsFor()} months. Later dates open as time passes.`;
        } else {
          calWindowLimitEl.hidden = true;
        }
      }
    }

    calPrevBtn?.addEventListener('click', () => {
      const idx = viewIdx(calView.y, calView.m) - 1;
      if (idx < calMinIdx) return;
      calView = { y: Math.floor(idx / 12), m: ((idx % 12) + 12) % 12 };
      calRender();
    });
    calNextBtn?.addEventListener('click', () => {
      const idx = viewIdx(calView.y, calView.m) + 1;
      if (idx > calMaxIdx) return;
      calView = { y: Math.floor(idx / 12), m: ((idx % 12) + 12) % 12 };
      calRender();
    });

    // ---- Keyboard navigation across the grid -------------------------------------------------
    // Moves the roving tab stop, paging the month automatically when the target falls outside it.
    // Clamped to the bookable range so arrowing can never leave the window.
    function focusCell(iso: string) {
      if (iso < R.earliest) iso = R.earliest;
      if (iso > calLatest) iso = calLatest;
      const y = +iso.slice(0, 4);
      const m = +iso.slice(5, 7) - 1;
      if (y !== calView.y || m !== calView.m) {
        const idx = viewIdx(y, m);
        if (idx < calMinIdx || idx > calMaxIdx) return;
        calView = { y, m };
        calFocusIso = iso;
        calRender();
      }
      calFocusIso = iso;
      const target = calGrid?.querySelector<HTMLButtonElement>(`[data-iso="${iso}"]`);
      if (target) {
        calGrid?.querySelectorAll<HTMLButtonElement>('[tabindex="0"]').forEach((b) => { b.tabIndex = -1; });
        target.tabIndex = 0;
        target.focus();
      }
    }

    calGrid?.addEventListener('keydown', (ev) => {
      const key = (ev as KeyboardEvent).key;
      if (key === 'Escape') {
        if (previewEl && !previewEl.hidden) { ev.preventDefault(); closePreview(true); }
        return;
      }
      const from = (ev.target as HTMLElement)?.dataset?.iso;
      if (!from) return;
      let to: string | null = null;
      if (key === 'ArrowLeft') to = addDaysIso(from, -1);
      else if (key === 'ArrowRight') to = addDaysIso(from, 1);
      else if (key === 'ArrowUp') to = addDaysIso(from, -7);
      else if (key === 'ArrowDown') to = addDaysIso(from, 7);
      else if (key === 'Home') to = addDaysIso(from, -((new Date(from + 'T00:00:00Z').getUTCDay() + 6) % 7));
      else if (key === 'End') to = addDaysIso(from, 6 - ((new Date(from + 'T00:00:00Z').getUTCDay() + 6) % 7));
      else if (key === 'PageUp' || key === 'PageDown') {
        const delta = key === 'PageUp' ? -1 : 1;
        const idx = viewIdx(calView.y, calView.m) + delta;
        if (idx < calMinIdx || idx > calMaxIdx) return;
        const ny = Math.floor(idx / 12);
        const nm = ((idx % 12) + 12) % 12;
        const dim = new Date(Date.UTC(ny, nm + 1, 0)).getUTCDate();
        to = isoYMD(ny, nm, Math.min(+from.slice(8, 10), dim));
      }
      if (!to) return;
      ev.preventDefault();
      previewDismissedIso = ''; // arrowing to a new cell re-opens the preview
      focusCell(to);
    });

    // ---- Month/year jump ---------------------------------------------------------------------
    // Populated once across the whole bookable range. The international window is 24 months, and
    // paging that far one month at a time is the failure mode of calendar pickers.
    function buildJump() {
      if (!calJump) return;
      calJump.textContent = '';
      for (let idx = calMinIdx; idx <= calMaxIdx; idx++) {
        const y = Math.floor(idx / 12);
        const m = ((idx % 12) + 12) % 12;
        const opt = document.createElement('option');
        opt.value = String(idx);
        opt.textContent = humanDate(isoYMD(y, m, 1), { month: 'long', year: 'numeric' });
        calJump.appendChild(opt);
      }
      calJump.value = String(viewIdx(calView.y, calView.m));
    }

    calJump?.addEventListener('change', () => {
      const idx = Number(calJump.value);
      if (!Number.isFinite(idx) || idx < calMinIdx || idx > calMaxIdx) return;
      calView = { y: Math.floor(idx / 12), m: ((idx % 12) + 12) % 12 };
      closePreview();
      calRender();
    });

    // The soonest date this party can actually act on, used for the "next available" hint.
    function calNextAvailable(): string | null {
      let iso = R.earliest > todayIso ? R.earliest : todayIso;
      const limit = latestFor();
      let guard = 0;
      while (iso <= limit && guard < 800) {
        if (actionable(classifyDate(iso))) return iso;
        iso = addDaysIso(iso, 1);
        guard++;
      }
      return null;
    }

    function calUpdateNextAvail() {
      if (!calNextAvailEl) return;
      const iso = calNextAvailable();
      if (!iso) {
        calNextAvailEl.hidden = true;
        return;
      }
      calNextAvailEl.hidden = false;
      calNextAvailEl.textContent = `Soonest start date for ${groupSize()} walkers: ${humanDate(iso, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}.`;
    }

    // Re-filters and repaints from whatever is currently in the store (no fetch).
    function calRefresh() {
      calLatest = latestFor();
      calMaxIdx = viewIdx(+calLatest.slice(0, 4), +calLatest.slice(5, 7) - 1);
      if (viewIdx(calView.y, calView.m) > calMaxIdx) {
        calView = { y: +calLatest.slice(0, 4), m: +calLatest.slice(5, 7) - 1 };
      }
      if (calSelected && !actionable(classifyDate(calSelected))) {
        showPathNotice(`${humanDate(calSelected, { day: 'numeric', month: 'long', year: 'numeric' })} no longer fits this booking, so the date has been cleared. Please choose another.`);
        calClearSelection();
      }
      buildJump();
      calRender();
      calUpdateNextAvail();
    }

    // ---- Step 1 counters ----------------------------------------------------------------------
    // Two steppers write to hidden inputs, which are what everything else reads. Own rooms only
    // land on values that leave an even number sharing (guests pair up within their own booking);
    // the SADC count runs 0 to the number of walkers. At a limit the button is aria-disabled
    // rather than disabled, so it keeps focus and a screen reader still hears why nothing moved.
    type CounterKey = 'single' | 'sadc';
    const counterInputs: Record<CounterKey, HTMLInputElement | null> = { single: singleInput, sadc: sadcInput };
    function counterOptions(key: CounterKey): number[] {
      const n = groupSize();
      if (key === 'sadc') return Array.from({ length: n + 1 }, (_, i) => i);
      const out: number[] = [];
      for (let v = n % 2; v <= n; v += 2) out.push(v);
      return out;
    }
    function paintCounter(key: CounterKey): void {
      const input = counterInputs[key];
      if (!input) return;
      const opts = counterOptions(key);
      const v = Number(input.value);
      const out = form!.querySelector<HTMLElement>(`[data-count-value="${key}"]`);
      if (out) out.textContent = String(v);
      form!.querySelector(`[data-count-dec="${key}"]`)?.setAttribute('aria-disabled', v <= opts[0] ? 'true' : 'false');
      form!.querySelector(`[data-count-inc="${key}"]`)?.setAttribute('aria-disabled', v >= opts[opts.length - 1] ? 'true' : 'false');
    }
    function stepCounter(key: CounterKey, dir: 1 | -1): void {
      const input = counterInputs[key];
      if (!input) return;
      const v = Number(input.value);
      const opts = counterOptions(key);
      const next = dir > 0 ? opts.find((o) => o > v) : [...opts].reverse().find((o) => o < v);
      if (next === undefined) return;
      input.value = String(next);
      paintCounter(key);
      onCountsChanged();
    }
    for (const key of ['single', 'sadc'] as CounterKey[]) {
      form.querySelector(`[data-count-dec="${key}"]`)?.addEventListener('click', () => stepCounter(key, -1));
      form.querySelector(`[data-count-inc="${key}"]`)?.addEventListener('click', () => stepCounter(key, 1));
    }

    // The supplement quoted in the step 1 hint: the base-year high-season figure shipped in the
    // markup until a date is chosen, then that date's figure.
    const supplementDefault = supplementEl?.textContent ?? '';
    function paintSupplement(): void {
      if (!supplementEl) return;
      supplementEl.textContent = selectedStartIso ? fmtR(supplementCents(selectedStartIso, false)) : supplementDefault;
    }

    // Anything in step 1 can move the price, the booking window and which dates fit, so every
    // change repaints the calendar; calRefresh clears a chosen date that no longer fits and says so.
    function onCountsChanged(): void {
      if (CATERING === 'catered' && residencyBlock) {
        const needed = sadcCount() > 0;
        residencyBlock.hidden = !needed;
        if (!needed && residencyDeclare) residencyDeclare.checked = false;
        if (!needed && residencyError) residencyError.textContent = '';
      }
      hidePathNotice();
      calRefresh();
      joinRefresh();
      updateEstimate();
    }

    for (const input of Array.from(form.querySelectorAll<HTMLInputElement>('input[name="groupSize"]'))) {
      input.addEventListener('change', () => {
        // A new walker count resets own rooms to its default (1 if odd, else 0) and keeps the SADC
        // count within the party.
        const n = groupSize();
        if (singleInput && CATERING === 'catered') singleInput.value = String(n % 2);
        if (sadcInput && Number(sadcInput.value) > n) sadcInput.value = String(n);
        paintCounter('single');
        paintCounter('sadc');
        onCountsChanged();
      });
    }

    ageConfirm?.addEventListener('change', () => {
      if (ageConfirm.checked && ageError) ageError.textContent = '';
      refreshSteps();
    });

    residencyDeclare?.addEventListener('change', () => {
      if (residencyDeclare.checked && residencyError) residencyError.textContent = '';
      refreshSteps();
    });

    // ---- Interest capture (the empty soonest-available state) ---------------------------------
    // Goes through the EXISTING createInquiry action; no new endpoint.
    function bindInterestCapture(opts: {
      submitBtn: HTMLButtonElement | null;
      statusEl: HTMLElement | null;
      nameEl: HTMLInputElement | null;
      emailEl: HTMLInputElement | null;
      monthsEl: HTMLInputElement | null;
      honeypotEl: HTMLInputElement | null;
      idleLabel: string;
      compose: (months: string, n: number) => string;
      success: string;
    }) {
      const { submitBtn, statusEl, nameEl, emailEl, monthsEl, honeypotEl, idleLabel, compose, success } = opts;
      submitBtn?.addEventListener('click', async () => {
        const say = (msg: string, kind: 'error' | 'success') => {
          if (!statusEl) return;
          statusEl.textContent = msg;
          statusEl.dataset.kind = kind;
        };
        if (honeypotEl?.value) return; // honeypot

        const name = nameEl?.value.trim() ?? '';
        const email = emailEl?.value.trim() ?? '';
        const months = monthsEl?.value.trim() ?? '';

        const nameErr = firstErr(name, nameRules);
        const emailErr = firstErr(email, emailRules);
        if (nameEl) markField(nameEl.closest('.form-field'), nameErr);
        if (emailEl) markField(emailEl.closest('.form-field'), emailErr);
        if (nameErr) return nameEl?.focus();
        if (emailErr) return emailEl?.focus();

        const n = groupSize();
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';

        const { error } = await actions.createInquiry({
          name,
          email,
          groupSize: String(n),
          targetDates: months || undefined,
          message: compose(months, n),
        });

        submitBtn.textContent = idleLabel;
        if (error) {
          submitBtn.disabled = false;
          say(error.message || 'Something went wrong. Please try again.', 'error');
          return;
        }
        say(success, 'success');
      });
    }

    bindInterestCapture({
      submitBtn: notifySubmit,
      statusEl: notifyStatus,
      nameEl: notifyName,
      emailEl: notifyEmail,
      monthsEl: notifyMonths,
      honeypotEl: notifyCompany,
      idleLabel: 'Notify me',
      compose: (months, n) =>
        `Notify me when a ${CATERING_WORD} departure opens for a group of ${n}${months ? `, ideally around ${months}` : ''}.`,
      success: "Thanks. We'll be in touch as soon as a matching date opens.",
    });

    // ---- Cancellation-policy dialog ----------------------------------------------------------
    const policyModal = form.querySelector<HTMLDialogElement>('[data-policy-modal]');
    form.querySelector<HTMLButtonElement>('[data-policy-open]')?.addEventListener('click', () => {
      policyModal?.showModal();
    });
    for (const sel of ['[data-policy-close]', '[data-policy-close-foot]']) {
      form.querySelector<HTMLButtonElement>(sel)?.addEventListener('click', () => policyModal?.close());
    }

    const setStatus = (msg: string, kind: 'error' | 'info' = 'error') => {
      if (!status) return;
      status.textContent = msg;
      status.dataset.kind = kind;
    };

    // ---- Abandoned-checkout recovery ---------------------------------------------------------
    // A guest who returns (back-button, bfcache, or a fresh visit to a stashed reference) sees an
    // explicit confirm prompt rather than a silent auto-redirect: hitting back to re-check a date
    // must not lose the hold with no warning.
    const PENDING_KEY = 'rw_checkout_pending';
    const resumePrompt = document.querySelector<HTMLElement>('[data-resume-prompt]');
    const resumeContinueBtn = resumePrompt?.querySelector<HTMLButtonElement>('[data-resume-continue]') ?? null;
    const resumeReleaseBtn = resumePrompt?.querySelector<HTMLButtonElement>('[data-resume-release]') ?? null;

    const pendingRef = sessionStorage.getItem(PENDING_KEY);
    if (pendingRef && resumePrompt) {
      resumePrompt.hidden = false;
      resumeContinueBtn?.focus();
    }

    resumeContinueBtn?.addEventListener('click', async () => {
      if (!pendingRef) return;
      resumeContinueBtn.disabled = true;
      resumeContinueBtn.textContent = 'Taking you to checkout…';
      const { data, error } = await actions.resumeCheckout({ reference: pendingRef });
      if (error || !data?.authorizationUrl) {
        sessionStorage.removeItem(PENDING_KEY);
        if (resumePrompt) resumePrompt.hidden = true;
        setStatus(error?.message || 'That booking could not be resumed. Please start a new one below.');
        return;
      }
      sessionStorage.setItem(PENDING_KEY, data.reference ?? '');
      window.location.href = data.authorizationUrl;
    });

    resumeReleaseBtn?.addEventListener('click', () => {
      sessionStorage.removeItem(PENDING_KEY);
      if (pendingRef) {
        window.location.href = `/booking/cancel?reference=${encodeURIComponent(pendingRef)}`;
      } else if (resumePrompt) {
        resumePrompt.hidden = true;
      }
    });

    // ---- Submit ------------------------------------------------------------------------------
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('', 'info');
      if (resumeBtn) resumeBtn.hidden = true;
      const fd = new FormData(form);

      if (!ageConfirm?.checked) {
        setStatus('Please tick the age confirmation in step 1 to continue.');
        goToStep(1);
        return;
      }
      if (!residencyValid()) {
        setStatus('Please tick the SADC confirmation in step 1 to continue.');
        goToStep(1);
        return;
      }
      const startVal = String(fd.get('startDate') ?? '');
      if (!startVal) {
        setStatus('Please choose a start date from the calendar.');
        goToStep(2);
        return;
      }
      const fieldChecks: Array<[HTMLInputElement, Rule[]]> = [
        [nameInput, nameRules],
        [emailInput, emailRules],
        [phoneInput, phoneRules],
      ];
      let firstBad: HTMLElement | null = null;
      for (const [el, rules] of fieldChecks) {
        const err = firstErr(el.value, rules);
        markField(el.closest('.form-field'), err);
        if (err && !firstBad) firstBad = el;
      }
      if (firstBad) { firstBad.focus(); return; }

      const payload = {
        startDate: startVal,
        groupSize: groupSize(),
        catering: CATERING,
        // Counts only. The server prices every line itself; the browser never sends a price or
        // a rate band.
        singleRooms: singleRooms(),
        sadcCount: sadcCount(),
        residencyDeclaration: sadcCount() > 0 && residencyDeclare?.checked === true,
        ageConfirmed: ageConfirm?.checked === true,
        leadName: String(fd.get('leadName') ?? ''),
        leadEmail: String(fd.get('leadEmail') ?? ''),
        leadPhone: String(fd.get('leadPhone') ?? ''),
        company: (fd.get('company') as string) || undefined,
      };

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Taking you to checkout…';
      }

      const { data, error } = await actions.createCheckout(payload);

      if (error) {
        setStatus(error.message || 'Something went wrong. Please try again.');
        // The duplicate-booking conflict for a live pending hold offers a resume path — kept in
        // sync with the exact message actions/index.ts throws for that case.
        if (resumeBtn && error.message?.includes('waiting for payment')) resumeBtn.hidden = false;
        if (submit) {
          submit.disabled = false;
          updateEstimate(); // restore the correct button label
        }
        // A conflict means someone else moved first: refresh the grid so the guest sees why.
        void syncAvailability();
        return;
      }
      if (data?.authorizationUrl) {
        // Store the reference so on back-navigation we can offer to resume the same booking.
        sessionStorage.setItem(PENDING_KEY, data.reference ?? '');
        window.location.href = data.authorizationUrl;
      }
    });

    resumeBtn?.addEventListener('click', async () => {
      resumeBtn.disabled = true;
      resumeBtn.textContent = 'Taking you to checkout…';
      const { data, error } = await actions.resumeCheckout({ leadEmail: emailInput.value });
      if (error || !data?.authorizationUrl) {
        resumeBtn.disabled = false;
        resumeBtn.textContent = 'Resume payment';
        setStatus(error?.message || 'That booking could not be resumed.');
        return;
      }
      sessionStorage.setItem(PENDING_KEY, data.reference ?? '');
      window.location.href = data.authorizationUrl;
    });

    // ---- First paint -------------------------------------------------------------------------
    paintCounter('single');
    paintCounter('sadc');
    buildJump();
    calRender();
    calUpdateNextAvail();
    joinRefresh();
    goToStep(1, false);
    updateEstimate();
    void syncAvailability();
  }

  document.addEventListener('astro:page-load', initBooking);

  // bfcache restore: the guest pressed back from the Paystack page. The browser thaws the frozen
  // DOM (button still disabled) without firing astro:page-load, so re-enable the button and re-run
  // initBooking (which also re-checks the resume prompt). For full-reload back-navigation,
  // astro:page-load fires instead and initBooking already handles it.
  window.addEventListener('pageshow', (e) => {
    if (!(e as PageTransitionEvent).persisted) return;
    const form = document.getElementById('booking-form') as HTMLFormElement | null;
    if (!form) return;
    const sub = form.querySelector<HTMLButtonElement>('[data-submit]');
    if (sub) sub.disabled = false;
    form.removeAttribute('data-bound');
    initBooking();
  });
</script>
