---
// DayCard — Part 7. One itinerary day. distanceKm null => "No walking" (Day 1).
// Walking days carry an elevation profile, drawn by ElevationChart.astro (a hand-authored
// inline SVG — see the note on ElevationProfile in data/itinerary.ts for why this replaced
// the old Google Maps screenshot images).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ElevationChart from './ElevationChart.astro';
import type { ElevationProfile } from '../data/itinerary';

interface Props {
  day: number;
  title: string;
  distanceKm: number | null;
  from?: string;
  to?: string;
  description: string;
  colorVar?: string;
  elevationProfile?: ElevationProfile;
  elevationAlt?: string;
  elevationCaption?: string;
  photo?: ImageMetadata; // a real photo of that night's lodge, paired with the elevation chart
  photoAlt?: string;
}
const {
  day,
  title,
  distanceKm,
  from,
  to,
  description,
  colorVar,
  elevationProfile,
  elevationAlt,
  elevationCaption,
  photo,
  photoAlt,
} = Astro.props;
// Accent is selected by data attribute, not inline style: the emitted CSP carries style hashes,
// which makes browsers ignore 'unsafe-inline', so inline style="" is blocked in production.
// `--color-day2` -> `day2`; see the [data-accent] rules in global.css.
const accentKey = (colorVar ?? '--color-green').replace('--color-', '');
const noWalking = distanceKm === null;
---

<li class="daycard" data-accent={accentKey}>
  <div class="daycard__marker">
    <span class="daycard__daylabel">Day</span>
    <span class="daycard__num">{day}</span>
  </div>
  <div class:list={['daycard__body', (elevationProfile || photo) && 'daycard__body--split']}>
    <div class="daycard__text">
      <div class="daycard__head">
        <h3 class="daycard__title">{title}</h3>
        <span class:list={['daycard__distance', noWalking && 'daycard__distance--rest']}>
          {noWalking ? 'No walking' : `~${distanceKm} km`}
        </span>
      </div>
      {
        from && to && (
          <p class="daycard__route">
            <span>{from}</span>
            <span class="daycard__arrow" aria-hidden="true">&rarr;</span>
            <span>{to}</span>
          </p>
        )
      }
      <p class="daycard__desc">{description}</p>
    </div>
    {
      (elevationProfile || photo) && (
        <div class:list={['daycard__media', !elevationProfile && 'daycard__media--photo-only']}>
          {elevationProfile && (
            <figure class="daycard__elevation">
              <ElevationChart
                day={day}
                points={elevationProfile.points}
                axisMin={elevationProfile.axisMin}
                axisMax={elevationProfile.axisMax}
                axisStep={elevationProfile.axisStep}
                distanceKm={elevationProfile.distanceKm}
                landmarkLabel={elevationProfile.landmarkLabel}
                landmarkFrac={elevationProfile.landmarkFrac}
                alt={elevationAlt ?? `Day ${day} elevation profile`}
              />
              {elevationCaption && <figcaption>{elevationCaption}</figcaption>}
            </figure>
          )}
          {photo && (
            <Image
              src={photo}
              alt={photoAlt ?? ''}
              class="daycard__photo"
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 32vw, (min-width: 640px) 45vw, 90vw"
              loading="lazy"
            />
          )}
        </div>
      )
    }
  </div>
</li>
