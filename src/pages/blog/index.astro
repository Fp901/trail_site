---
// The blog (CLAUDE.md Part 18, migration 0025): every article the owner has published from
// /admin/marketing, newest first. Rendered on demand so a new article shows without a rebuild;
// the edge keeps the page for a minute. Until the first article is live the page says so and
// asks search engines not to index an empty list.
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import BlogCover from '../../components/blog/BlogCover.astro';
import { BLOG_CACHE, blogDate, coverFor, listBlogPosts, type BlogListItem } from '../../lib/blog-posts';
import { blogSchema, breadcrumbSchema, webPageSchema } from '../../data/schema';
import { withBase } from '../../data/site';

export const prerender = false;

const title = 'Walking Safari Blog | Rooiberg Wander';
const description =
  'Stories and plain answers from a guided Big 5 walking safari in the Waterberg: what to pack, when to go and what three days on foot are really like.';

let posts: BlogListItem[] = [];
let failed = false;
try {
  posts = await listBlogPosts();
  Astro.response.headers.set('Cache-Control', BLOG_CACHE);
} catch {
  failed = true;
  Astro.response.status = 503;
}

const jsonLd = [
  webPageSchema({ path: '/blog', name: title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
  ...(posts.length
    ? [blogSchema({ description, posts: posts.map((p) => ({ path: `/blog/${p.slug}`, headline: p.title, datePublished: p.published_at })) })]
    : []),
];
---

<Layout title={title} description={description} path="/blog" noindex={posts.length === 0} jsonLd={jsonLd}>
  <Section bg="cream" labelledby="blog-heading">
    <div class="max-w-3xl">
      <p class="eyebrow">Blog</p>
      <h1 id="blog-heading" class="font-display text-4xl leading-[1.08] text-earth sm:text-5xl">
        Notes from the trail
      </h1>
      <p class="mt-5 font-body text-lg leading-relaxed text-charcoal/80">
        What to pack, when to come and what three days on foot through the Waterberg are like, from
        the people who walk it.
      </p>
    </div>

    {
      failed ? (
        <p class="mt-14 font-body text-charcoal/80">The articles could not be loaded just now. Please try again in a moment.</p>
      ) : posts.length === 0 ? (
        <p class="mt-14 font-body text-charcoal/80">The first articles are on their way.</p>
      ) : (
        <ol class="blog-list mt-14" role="list">
          {posts.map((p, i) => {
            const cover = coverFor(p.cover_photo_id, p.slug);
            return (
              <li class:list={['blog-item', { 'blog-item--lead': i === 0 }]}>
                {cover && (
                  <a href={withBase(`/blog/${p.slug}`)} class="blog-item__media" tabindex="-1" aria-hidden="true">
                    <BlogCover
                      cover={cover}
                      alt=""
                      eager={i === 0}
                      sizes={i === 0 ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 768px) 40vw, 100vw'}
                      class="blog-item__img"
                    />
                  </a>
                )}
                <div class="blog-item__text">
                  <p class="blog-item__date">
                    <time datetime={p.published_at}>{blogDate(p.published_at)}</time>
                  </p>
                  <h2 class="font-display text-earth">
                    <a href={withBase(`/blog/${p.slug}`)} class="blog-item__link">{p.title}</a>
                  </h2>
                  <p class="mt-3 font-body leading-relaxed text-charcoal/80">{p.description}</p>
                </div>
              </li>
            );
          })}
        </ol>
      )
    }
  </Section>
</Layout>

<style>
  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ochre);
  }
  .blog-list {
    display: grid;
    gap: 3.5rem;
    list-style: none;
    padding: 0;
  }
  .blog-item {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .blog-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .blog-item__media {
    display: block;
    overflow: hidden;
    border-radius: 1.5rem;
  }
  :global(.blog-item__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .blog-item:hover :global(.blog-item__img) {
    transform: scale(1.02);
  }
  .blog-item__date {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
  }
  .blog-item h2 {
    margin-top: 0.6rem;
    font-size: 1.6rem;
    line-height: 1.12;
  }
  .blog-item--lead h2 {
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
  }
  .blog-item__link {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--color-ochre), var(--color-ochre));
    background-size: 0% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 300ms ease;
  }
  .blog-item__link:hover,
  .blog-item__link:focus-visible {
    background-size: 100% 2px;
  }
  /* The newest article leads, wide; the rest sit image beside text, offset rather than in a grid. */
  @media (min-width: 768px) {
    .blog-item:not(.blog-item--lead) {
      grid-template-columns: 2fr 3fr;
      align-items: center;
      gap: 2.5rem;
    }
    .blog-item:not(.blog-item--lead):nth-child(odd) .blog-item__media {
      order: 2;
    }
  }
  @media (min-width: 1024px) {
    .blog-item--lead {
      grid-template-columns: 3fr 2fr;
      align-items: end;
      gap: 3rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.blog-item__img),
    .blog-item__link {
      transition: none;
    }
  }
</style>
