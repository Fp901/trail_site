---
// Marketing drafts (CLAUDE.md Part 18). prerender=false; gated server-side. Lists the AI
// marketing team's pending drafts for approve, edit-and-approve or reject, each with an optional
// reason (adminDecideDraft action). Approving never publishes: no publisher exists yet.
import Layout from '../../layouts/Layout.astro';
import '../../styles/admin.css';
import Section from '../../components/Section.astro';
import AdminNav from '../../components/AdminNav.astro';
import { getAdminUser } from '../../lib/auth';
import { getSupabaseAdmin } from '../../lib/supabase';
import {
  MARKETING_DRAFT_COLUMNS,
  sel,
  type MarketingDraftRow,
  type MarketingDraftKind,
} from '../../lib/db.types';
import { withBase } from '../../data/site';

export const prerender = false;

const user = await getAdminUser(Astro.cookies);
if (!user) {
  return Astro.redirect(withBase('/admin/login'));
}

let pending: MarketingDraftRow[] = [];
let recent: MarketingDraftRow[] = [];
let loadError = false;

try {
  const mk = getSupabaseAdmin().schema('marketing');
  const columns = sel<MarketingDraftRow, typeof MARKETING_DRAFT_COLUMNS>(MARKETING_DRAFT_COLUMNS);
  const [p, r] = await Promise.all([
    mk.from('drafts').select(columns).eq('status', 'pending').order('created_at', { ascending: true }).limit(100),
    mk.from('drafts').select(columns).neq('status', 'pending').order('decided_at', { ascending: false }).limit(10),
  ]);
  if (p.error) throw p.error;
  if (r.error) throw r.error;
  pending = (p.data as unknown as MarketingDraftRow[]) ?? [];
  recent = (r.data as unknown as MarketingDraftRow[]) ?? [];
} catch {
  loadError = true;
}

const KIND_LABEL: Record<MarketingDraftKind, string> = {
  x_post: 'X post',
  instagram_caption: 'Instagram caption',
  facebook_post: 'Facebook post',
  blog_draft: 'Blog draft',
  enquiry_reply: 'Enquiry reply',
  weekly_report: 'Weekly report',
};
const AUTHOR_LABEL: Record<string, string> = {
  head_of_marketing: 'Head of Marketing',
  researcher: 'Researcher',
  copywriter: 'Copywriter',
  editor: 'Editor',
  community_manager: 'Community Manager',
  sales_assistant: 'Sales Assistant',
  analyst: 'Analyst',
};

const fmtDateTime = (v: string | null) =>
  v ? new Date(v).toLocaleString('en-ZA', { timeZone: 'Africa/Johannesburg' }) : '';
---

<Layout
  title="Marketing drafts | Operator dashboard"
  description="Operator dashboard."
  path="/admin/marketing"
  noindex={true}
>
  <Section bg="cream" labelledby="mk-heading" space="lg">
    <AdminNav email={user.email ?? ''} active="marketing" />

    <div class="mt-8">
      <p class="font-body text-sm font-medium uppercase tracking-[0.18em] text-green">
        Operator dashboard
      </p>
      <h1 id="mk-heading" class="mt-3 font-display text-4xl text-earth sm:text-5xl">
        Marketing drafts
      </h1>
      <p class="mt-3 font-body text-charcoal/75">
        {pending.length === 0
          ? 'No drafts are waiting.'
          : `${pending.length} ${pending.length === 1 ? 'draft is' : 'drafts are'} waiting for you.`}
        {' '}Approving a draft does not publish it. Your reason, if you give one, teaches the Copywriter.
      </p>
    </div>

    {
      loadError ? (
        <p class="mt-10 font-body text-charcoal">Could not load drafts. Please try again.</p>
      ) : (
        <>
          {pending.length > 0 && (
            <ol class="admin-inqs mt-8">
              {pending.map((d) => (
                <li class="admin-inq" data-draft-id={d.id}>
                  <div class="admin-inq__head">
                    <div>
                      <p class="admin-name">{d.title || KIND_LABEL[d.kind as MarketingDraftKind] || d.kind}</p>
                      <p class="admin-sub">
                        {KIND_LABEL[d.kind as MarketingDraftKind] || d.kind}
                        {' · '}
                        {AUTHOR_LABEL[d.author] || d.author}
                        {' · '}
                        {fmtDateTime(d.created_at)}
                      </p>
                    </div>
                    <div class="admin-inq__state">
                      {d.editor_status === 'passed' && <span class="admin-ok">Editor: passed</span>}
                      {d.editor_status === 'flagged' && <span class="admin-flag">Editor: flagged</span>}
                      {d.editor_status === 'unchecked' && <span class="admin-sub">Editor: not checked yet</span>}
                    </div>
                  </div>
                  {d.editor_notes && <p class="admin-sub admin-inq__meta">Editor notes: {d.editor_notes}</p>}
                  {(d.departure_date || d.photo_ids.length > 0) && (
                    <p class="admin-sub admin-inq__meta">
                      {d.departure_date && `Departure: ${d.departure_date}`}
                      {d.departure_date && d.photo_ids.length > 0 && ' · '}
                      {d.photo_ids.length > 0 && `Photos: ${d.photo_ids.join(', ')}`}
                    </p>
                  )}
                  {d.notes && <p class="admin-sub admin-inq__meta">Note from the agent: {d.notes}</p>}
                  <form data-decide novalidate class="mt-4">
                    <div class="form-field">
                      <label for={`mk-body-${d.id}`}>Text (edit before approving if you like)</label>
                      <textarea id={`mk-body-${d.id}`} name="body" rows="6" maxlength="20000">{d.body}</textarea>
                    </div>
                    <div class="form-field">
                      <label for={`mk-reason-${d.id}`}>Reason (optional)</label>
                      <input id={`mk-reason-${d.id}`} name="reason" type="text" maxlength="1000" />
                    </div>
                    <div class="admin-actions">
                      <button type="submit" class="btn btn-primary" value="approve">Approve</button>
                      <button type="submit" class="btn btn-secondary" value="reject">Reject</button>
                    </div>
                    <p class="bform__status" data-status role="status" aria-live="polite" />
                  </form>
                </li>
              ))}
            </ol>
          )}

          {recent.length > 0 && (
            <div class="mt-12">
              <h2 class="font-display text-2xl text-earth">Recently decided</h2>
              <ol class="admin-inqs mt-4">
                {recent.map((d) => (
                  <li class="admin-inq admin-inq--handled">
                    <p class="admin-name">{d.title || KIND_LABEL[d.kind as MarketingDraftKind] || d.kind}</p>
                    <p class="admin-sub">
                      {d.status === 'approved' ? (d.original_body ? 'Edited and approved' : 'Approved') : 'Rejected'}
                      {d.decided_by && ` by ${d.decided_by}`}
                      {d.decided_at && `, ${fmtDateTime(d.decided_at)}`}
                    </p>
                    {d.decision_reason && <p class="admin-sub">Reason: {d.decision_reason}</p>}
                  </li>
                ))}
              </ol>
            </div>
          )}
        </>
      )
    }
  </Section>
</Layout>

<script>
  import { actions } from 'astro:actions';

  function initDrafts() {
    document.querySelectorAll<HTMLElement>('[data-draft-id]').forEach((row) => {
      if (row.dataset.bound === 'true') return;
      row.dataset.bound = 'true';
      const form = row.querySelector<HTMLFormElement>('form[data-decide]');
      const statusEl = row.querySelector<HTMLElement>('[data-status]');
      form?.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const submitter = (ev as SubmitEvent).submitter as HTMLButtonElement | null;
        const decision = submitter?.value === 'reject' ? 'reject' : 'approve';
        const body = (form.elements.namedItem('body') as HTMLTextAreaElement).value.trim();
        const reason = (form.elements.namedItem('reason') as HTMLInputElement).value.trim();
        const buttons = form.querySelectorAll<HTMLButtonElement>('button');
        buttons.forEach((b) => (b.disabled = true));
        const { error } = await actions.adminDecideDraft({
          draftId: row.dataset.draftId!,
          decision,
          body: decision === 'approve' && body ? body : undefined,
          reason: reason || undefined,
        });
        if (error) {
          if (statusEl) {
            statusEl.textContent = error.message || 'Something went wrong.';
            statusEl.dataset.kind = 'error';
          }
          buttons.forEach((b) => (b.disabled = false));
          return;
        }
        window.location.reload();
      });
    });
  }

  initDrafts();
</script>
