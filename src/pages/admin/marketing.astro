---
// Marketing drafts (CLAUDE.md Part 18). prerender=false; gated server-side. Lists the AI
// marketing team's pending drafts for approve, edit-and-approve or reject, each with an optional
// reason (adminDecideDraft action). Approving never publishes: no publisher exists yet.
// Also uploads photos for the team (adminUploadMarketingPhoto) into the private marketing-photos
// bucket. Uploaded photos are listed as text only: the page's CSP allows images from 'self' alone,
// and the bucket is private, so no preview is shown here.
import Layout from '../../layouts/Layout.astro';
import '../../styles/admin.css';
import Section from '../../components/Section.astro';
import AdminNav from '../../components/AdminNav.astro';
import { getAdminUser } from '../../lib/auth';
import { getSupabaseAdmin } from '../../lib/supabase';
import {
  MARKETING_DRAFT_COLUMNS,
  MARKETING_PHOTO_CATEGORIES,
  MARKETING_PHOTO_COLUMNS,
  sel,
  type MarketingDraftRow,
  type MarketingDraftKind,
  type MarketingPhotoRow,
} from '../../lib/db.types';
import { PHOTO_LODGE_BY_KEY, PHOTO_UPLOAD_MAX_BYTES, photoLibrary } from '../../data/photo-library';
import { withBase } from '../../data/site';

export const prerender = false;

const user = await getAdminUser(Astro.cookies);
if (!user) {
  return Astro.redirect(withBase('/admin/login'));
}

let pending: MarketingDraftRow[] = [];
let recent: MarketingDraftRow[] = [];
let loadError = false;
const PHOTO_COLS = ['id', 'created_at', 'category', 'lodge', 'alt', 'uploaded_by'] as const satisfies readonly (typeof MARKETING_PHOTO_COLUMNS)[number][];
type PhotoListRow = Pick<MarketingPhotoRow, (typeof PHOTO_COLS)[number]>;
let photos: PhotoListRow[] = [];
let photosError = false;

try {
  const mk = getSupabaseAdmin().schema('marketing');
  const columns = sel<MarketingDraftRow, typeof MARKETING_DRAFT_COLUMNS>(MARKETING_DRAFT_COLUMNS);
  const [p, r] = await Promise.all([
    mk.from('drafts').select(columns).eq('status', 'pending').order('created_at', { ascending: true }).limit(100),
    mk.from('drafts').select(columns).neq('status', 'pending').order('decided_at', { ascending: false }).limit(10),
  ]);
  if (p.error) throw p.error;
  if (r.error) throw r.error;
  pending = (p.data as unknown as MarketingDraftRow[]) ?? [];
  recent = (r.data as unknown as MarketingDraftRow[]) ?? [];
} catch {
  loadError = true;
}

try {
  const { data, error } = await getSupabaseAdmin()
    .schema('marketing')
    .from('photos')
    .select(sel<MarketingPhotoRow, typeof PHOTO_COLS>(PHOTO_COLS))
    .order('created_at', { ascending: false })
    .limit(20);
  if (error) throw error;
  photos = (data as unknown as PhotoListRow[]) ?? [];
} catch {
  photosError = true;
}

const CATEGORY_LABEL: Record<(typeof MARKETING_PHOTO_CATEGORIES)[number], string> = {
  trail: 'Trail',
  lodge: 'Lodge',
  landscape: 'Landscape',
  wildlife: 'Wildlife',
  food: 'Food',
  guide: 'Guide',
};
const maxMb = PHOTO_UPLOAD_MAX_BYTES / 1024 / 1024;

const KIND_LABEL: Record<MarketingDraftKind, string> = {
  x_post: 'X post',
  instagram_caption: 'Instagram caption',
  facebook_post: 'Facebook post',
  blog_draft: 'Blog draft',
  enquiry_reply: 'Enquiry reply',
  weekly_report: 'Weekly report',
};
const FORMAT_LABEL: Record<string, string> = {
  single: 'Single photo post',
  carousel: 'Carousel (swipe through the photos in this order)',
  story: 'Story (put the text on the photo)',
};
// Site photos preview here (same origin, so the page's img-src 'self' allows them). Uploads live
// in a private bucket and are named by their description instead.
const SITE_PHOTO = new Map(photoLibrary.map((p) => [p.id, p]));
const uploadAlt = new Map(photos.map((ph) => [`upload-${ph.id}`, ph.alt]));
const AUTHOR_LABEL: Record<string, string> = {
  head_of_marketing: 'Head of Marketing',
  researcher: 'Researcher',
  copywriter: 'Copywriter',
  editor: 'Editor',
  community_manager: 'Community Manager',
  sales_assistant: 'Sales Assistant',
  analyst: 'Analyst',
};

const fmtDateTime = (v: string | null) =>
  v ? new Date(v).toLocaleString('en-ZA', { timeZone: 'Africa/Johannesburg' }) : '';
---

<Layout
  title="Marketing drafts | Operator dashboard"
  description="Operator dashboard."
  path="/admin/marketing"
  noindex={true}
>
  <Section bg="cream" labelledby="mk-heading" space="lg">
    <AdminNav email={user.email ?? ''} active="marketing" />

    <div class="mt-8">
      <p class="font-body text-sm font-medium uppercase tracking-[0.18em] text-green">
        Operator dashboard
      </p>
      <h1 id="mk-heading" class="mt-3 font-display text-4xl text-earth sm:text-5xl">
        Marketing drafts
      </h1>
      <p class="mt-3 font-body text-charcoal/75">
        {pending.length === 0
          ? 'No drafts are waiting.'
          : `${pending.length} ${pending.length === 1 ? 'draft is' : 'drafts are'} waiting for you.`}
        {' '}Approving a draft does not publish it. Your reason, if you give one, teaches the Copywriter.
      </p>
    </div>

    {
      loadError ? (
        <p class="mt-10 font-body text-charcoal">Could not load drafts. Please try again.</p>
      ) : (
        <>
          {pending.length > 0 && (
            <ol class="admin-inqs mt-8">
              {pending.map((d) => (
                <li class="admin-inq" data-draft-id={d.id}>
                  <div class="admin-inq__head">
                    <div>
                      <p class="admin-name">{d.title || KIND_LABEL[d.kind as MarketingDraftKind] || d.kind}</p>
                      <p class="admin-sub">
                        {KIND_LABEL[d.kind as MarketingDraftKind] || d.kind}
                        {' · '}
                        {AUTHOR_LABEL[d.author] || d.author}
                        {' · '}
                        {fmtDateTime(d.created_at)}
                      </p>
                    </div>
                    <div class="admin-inq__state">
                      {d.editor_status === 'passed' && <span class="admin-ok">Editor: passed</span>}
                      {d.editor_status === 'flagged' && <span class="admin-flag">Editor: flagged</span>}
                      {d.editor_status === 'unchecked' && <span class="admin-sub">Editor: not checked yet</span>}
                    </div>
                  </div>
                  {d.editor_notes && <p class="admin-sub admin-inq__meta">Editor notes: {d.editor_notes}</p>}
                  {(d.format || d.departure_date) && (
                    <p class="admin-sub admin-inq__meta">
                      {d.format && `Format: ${FORMAT_LABEL[d.format] ?? d.format}`}
                      {d.format && d.departure_date && ' · '}
                      {d.departure_date && `Departure: ${d.departure_date}`}
                    </p>
                  )}
                  {d.photo_ids.length > 0 && (
                    <ol class="mk-photos" aria-label="Photos for this post, in order">
                      {d.photo_ids.map((id) => {
                        const p = SITE_PHOTO.get(id);
                        return p ? (
                          <li>
                            <a href={p.image.src} download={`${id}.jpg`} title="Download this photo">
                              <img src={p.image.src} alt={p.alt} width={160} height={Math.round((160 * p.image.height) / p.image.width)} loading="lazy" decoding="async" />
                            </a>
                            <span class="admin-sub">{id}</span>
                          </li>
                        ) : (
                          <li class="admin-sub">Uploaded photo: {uploadAlt.get(id) ?? id}</li>
                        );
                      })}
                    </ol>
                  )}
                  {d.notes && <p class="admin-sub admin-inq__meta">Note from the agent: {d.notes}</p>}
                  <form data-decide novalidate class="mt-4">
                    <div class="form-field">
                      <label for={`mk-body-${d.id}`}>Text (edit before approving if you like)</label>
                      <textarea id={`mk-body-${d.id}`} name="body" rows="6" maxlength="20000">{d.body}</textarea>
                    </div>
                    <div class="form-field">
                      <label for={`mk-reason-${d.id}`}>Reason (optional)</label>
                      <input id={`mk-reason-${d.id}`} name="reason" type="text" maxlength="1000" />
                    </div>
                    <div class="admin-actions">
                      <button type="submit" class="btn btn-primary" value="approve">Approve</button>
                      <button type="submit" class="btn btn-secondary" value="reject">Reject</button>
                    </div>
                    <p class="bform__status" data-status role="status" aria-live="polite" />
                  </form>
                </li>
              ))}
            </ol>
          )}

          <div class="mt-12">
            <h2 id="mk-photos" class="font-display text-2xl text-earth">Photos for the team</h2>
            <p class="mt-2 font-body text-charcoal/75">
              Upload a photo the team may use. It is stored privately and the team only sees a link that
              expires. JPEG, PNG or WebP, up to {maxMb} MB.
            </p>
            <form data-photo-upload novalidate class="mt-4" enctype="multipart/form-data">
              <div class="form-field">
                <label for="mk-photo-file">Photo</label>
                <input id="mk-photo-file" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required />
              </div>
              <div class="form-field">
                <label for="mk-photo-category">Category</label>
                <select id="mk-photo-category" name="category" required>
                  {MARKETING_PHOTO_CATEGORIES.map((c) => <option value={c}>{CATEGORY_LABEL[c]}</option>)}
                </select>
              </div>
              <div class="form-field">
                <label for="mk-photo-lodge">Lodge (required for a lodge photo)</label>
                <select id="mk-photo-lodge" name="lodge">
                  <option value="">No lodge</option>
                  {Object.entries(PHOTO_LODGE_BY_KEY).map(([key, name]) => <option value={key}>{name}</option>)}
                </select>
              </div>
              <div class="form-field">
                <label for="mk-photo-alt">Describe the photo (alt text, 10 to 300 characters)</label>
                <input id="mk-photo-alt" name="alt" type="text" minlength="10" maxlength="300" required />
              </div>
              <label class="admin-card__check">
                <input id="mk-photo-trophies" name="noTrophies" type="checkbox" required />
                <span>This photo shows no hunting trophies (no mounted heads, horns, skulls, hides as decor or a hunter with a kill).</span>
              </label>
              <div class="admin-actions">
                <button type="submit" class="btn btn-primary">Upload photo</button>
              </div>
              <p class="bform__status" data-status role="status" aria-live="polite" />
            </form>

            {photosError ? (
              <p class="mt-6 font-body text-charcoal">Could not load uploaded photos.</p>
            ) : photos.length > 0 && (
              <ol class="admin-inqs mt-6">
                {photos.map((ph) => (
                  <li class="admin-inq admin-inq--handled">
                    <p class="admin-name">{ph.alt}</p>
                    <p class="admin-sub">
                      {CATEGORY_LABEL[ph.category] ?? ph.category}
                      {ph.lodge && ` · ${PHOTO_LODGE_BY_KEY[ph.lodge] ?? ph.lodge}`}
                      {` · upload-${ph.id} · ${ph.uploaded_by}, ${fmtDateTime(ph.created_at)}`}
                    </p>
                  </li>
                ))}
              </ol>
            )}
          </div>

          {recent.length > 0 && (
            <div class="mt-12">
              <h2 class="font-display text-2xl text-earth">Recently decided</h2>
              <ol class="admin-inqs mt-4">
                {recent.map((d) => (
                  <li class="admin-inq admin-inq--handled">
                    <p class="admin-name">{d.title || KIND_LABEL[d.kind as MarketingDraftKind] || d.kind}</p>
                    <p class="admin-sub">
                      {d.status === 'approved' ? (d.original_body ? 'Edited and approved' : 'Approved') : 'Rejected'}
                      {d.decided_by && ` by ${d.decided_by}`}
                      {d.decided_at && `, ${fmtDateTime(d.decided_at)}`}
                    </p>
                    {d.decision_reason && <p class="admin-sub">Reason: {d.decision_reason}</p>}
                  </li>
                ))}
              </ol>
            </div>
          )}
        </>
      )
    }
  </Section>
</Layout>

<script>
  import { actions } from 'astro:actions';

  function initDrafts() {
    document.querySelectorAll<HTMLElement>('[data-draft-id]').forEach((row) => {
      if (row.dataset.bound === 'true') return;
      row.dataset.bound = 'true';
      const form = row.querySelector<HTMLFormElement>('form[data-decide]');
      const statusEl = row.querySelector<HTMLElement>('[data-status]');
      form?.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const submitter = (ev as SubmitEvent).submitter as HTMLButtonElement | null;
        const decision = submitter?.value === 'reject' ? 'reject' : 'approve';
        const body = (form.elements.namedItem('body') as HTMLTextAreaElement).value.trim();
        const reason = (form.elements.namedItem('reason') as HTMLInputElement).value.trim();
        const buttons = form.querySelectorAll<HTMLButtonElement>('button');
        buttons.forEach((b) => (b.disabled = true));
        const { error } = await actions.adminDecideDraft({
          draftId: row.dataset.draftId!,
          decision,
          body: decision === 'approve' && body ? body : undefined,
          reason: reason || undefined,
        });
        if (error) {
          if (statusEl) {
            statusEl.textContent = error.message || 'Something went wrong.';
            statusEl.dataset.kind = 'error';
          }
          buttons.forEach((b) => (b.disabled = false));
          return;
        }
        window.location.reload();
      });
    });
  }

  function initPhotoUpload() {
    const form = document.querySelector<HTMLFormElement>('form[data-photo-upload]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const statusEl = form.querySelector<HTMLElement>('[data-status]');
    const say = (text: string, kind: 'error' | 'ok') => {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.dataset.kind = kind;
    };
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const file = (form.elements.namedItem('photo') as HTMLInputElement).files?.[0];
      const alt = (form.elements.namedItem('alt') as HTMLInputElement).value.trim();
      const ticked = (form.elements.namedItem('noTrophies') as HTMLInputElement).checked;
      if (!file) return say('Please choose a photo.', 'error');
      if (alt.length < 10) return say('Please describe the photo in at least 10 characters.', 'error');
      if (!ticked) return say('Please confirm the photo shows no hunting trophies.', 'error');
      const data = new FormData(form);
      if (!data.get('lodge')) data.delete('lodge');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      say('Uploading...', 'ok');
      const { error } = await actions.adminUploadMarketingPhoto(data);
      if (error) {
        say(error.message || 'Something went wrong.', 'error');
        if (button) button.disabled = false;
        return;
      }
      window.location.reload();
    });
  }

  initDrafts();
  initPhotoUpload();
</script>
