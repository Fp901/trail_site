---
// SADC self-catered slackpacking option — UNLISTED (memo 15 Sep 2026, item 3).
//
// This page is deliberately not part of the website's navigation, sitemap or llms.txt. It is the
// target of a QR code printed on the direct-marketing PDF sent to South African walking clubs,
// and it is the only place the self-catered product can be booked. The main site sells the
// all-inclusive catered flagship only, because (business plan 5.3) mixing a self-catering version
// into the public offer confuses the DMCs the inbound bookings depend on.
//
// It is `noindex` and excluded from the sitemap, but it is NOT listed in robots.txt: a Disallow
// line would publish the URL to anyone who reads robots.txt, which is the opposite of unlisted.
// It carries no secret, so an unguessable token would be security theatre; the protection is that
// nothing links to it.
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import BookingWidget from '../components/BookingWidget.astro';
import InquiryForm from '../components/InquiryForm.astro';
import {
  NIGHTS,
  MAX_GROUP_SIZE,
  MIN_PARTY_UNCATERED,
  RATE_BASE_YEAR,
  SADC_PREMIUM_PCT,
  SADC_WINDOW_MONTHS,
  START_DAYS_DISPLAY,
  TAPER_END_DISPLAY,
  BOOKING_OPEN_DISPLAY,
  SEASON_HIGH_LABEL,
  SEASON_HIGH_DATE_RANGES,
  SEASON_LOW_LABEL,
  LAST_MINUTE_DISCOUNT,
  formatRand,
  rateFor,
  sadcSelfCateredRates,
  uncateredInclusions,
  uncateredExclusions,
} from '../data/rates';
import { site, withBase } from '../data/site';
import PaymentTrust from '../components/PaymentTrust.astro';
import InclusionsSection from '../components/InclusionsSection.astro';
import RefundPolicySection from '../components/RefundPolicySection.astro';

const bookingEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_PAYSTACK_PUBLIC_KEY,
);
const inquiryEnabled = Boolean(import.meta.env.PUBLIC_SUPABASE_URL);

const baseLow = rateFor({ catering: 'uncatered', residency: 'sadc', year: RATE_BASE_YEAR, highSeason: false });

const title = 'SADC Self-catered Slackpacking Option | Rooiberg Wander';
const description =
  'A traditional self-catering slackpacking trail across a 15,000-hectare private Big 5 reserve in the Waterberg, opened to SADC residents at an accessible regional rate.';
---

<Layout
  title={title}
  description={description}
  path="/sadc-slackpacking"
  noindex={true}
  image="/images/share-sadc-slackpacking.jpg"
  footerHook={'Three days of guided walking through a private Big\u00A0Five reserve.'}
>
  <Section bg="cream" labelledby="sadc-heading">
    <div class="max-w-3xl">
      <p class="eyebrow">By direct invitation</p>
      <h1 id="sadc-heading" class="mt-3 font-display text-4xl text-earth sm:text-5xl md:text-6xl">
        SADC Self-catered Slackpacking Option
      </h1>

      <p class="mt-6 font-body text-lg leading-relaxed text-charcoal sm:text-xl">
        In support of local conservation access, unreserved trail departures are opened exclusively
        to SADC residents 12 months prior to departure on a traditional self-catering slackpacking
        basis for a minimum of {MIN_PARTY_UNCATERED} people per group. We provide bedding, ice,
        wood, cleaning staff and Wi-Fi.
      </p>

      <p class="mt-5 font-body leading-relaxed text-charcoal/85">
        This initiative offers local hiking clubs, corporate groups, and wilderness walkers the
        opportunity to traverse a 15,000-hectare private Big 5 reserve in the Waterberg at an
        accessible regional rate. Every resident booking directly funds the reserve's continuous
        anti-poaching operations, fence maintenance, and ecological monitoring programs.
      </p>

      <p class="mt-5 font-body leading-relaxed text-charcoal/85">
        We provide full access to the 3 private safari lodges, free ice, wood, WiFi, two armed
        FGASA field guides, and daily luggage and cooler-box portage between lodges. Guests bring
        their own food and beverages to cook in the fully equipped lodge kitchens.
      </p>

      <p class="mt-5 font-body leading-relaxed text-charcoal">
        <strong>
          A valid South African ID or SADC passport number is required at check-in. Guests unable
          to provide such proof pay a {SADC_PREMIUM_PCT}% premium at registration.
        </strong>
      </p>
    </div>
  </Section>

  <Section bg="cream" labelledby="sadc-rates-heading" space="md" containerClass="!pt-0">
    <div class="max-w-3xl">
      <h2 id="sadc-rates-heading" class="font-display text-2xl text-earth sm:text-3xl">
        The rate
      </h2>
      <p class="mt-4 font-body leading-relaxed text-charcoal">
        From {formatRand(baseLow)} per person sharing, for the whole {NIGHTS}-night trail, VAT and
        all conservation levies included.
      </p>

      {/* Same visual system as the /rates table (RatesTable.astro), without the currency tabs:
          this rate is charged in rand to local groups. Every figure is derived, never typed. */}
      <div class="ratetable-wrap mt-6">
        <table class="ratetable">
          <caption class="sr-only">
            Self-catered rates per person sharing, for the whole trail, by year and season. VAT
            and conservation levies included.
          </caption>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Rate year</span></th>
              <th scope="col">
                {SEASON_HIGH_LABEL}
                <span class="ratetable__seasonnote">
                  {SEASON_HIGH_DATE_RANGES.map((range) => (
                    <span class="ratetable__seasonrange">{range}</span>
                  ))}
                </span>
              </th>
              <th scope="col">{SEASON_LOW_LABEL}</th>
            </tr>
          </thead>
          <tbody>
            {
              sadcSelfCateredRates.map((r) => (
                <tr>
                  <th scope="row">
                    <span class="ratetable__label">{r.year}</span>
                    <span class="ratetable__qualifier">self-catered, incl. VAT</span>
                  </th>
                  <td>
                    <span class="ratetable__price">{formatRand(r.high)}</span>
                    <span class="ratetable__unit">per person sharing</span>
                  </td>
                  <td>
                    <span class="ratetable__price">{formatRand(r.low)}</span>
                    <span class="ratetable__unit">per person sharing</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="ratetable__fxnote">
          Book 8 to 21 days before arrival for a further {Math.round(LAST_MINUTE_DISCOUNT * 100)}% off.
          All payments are in South African Rand (ZAR).
        </p>
      </div>

      <p class="mt-5 font-body leading-relaxed text-charcoal/85">
        Groups of exactly {MIN_PARTY_UNCATERED}, which is also the maximum any departure takes
        ({MAX_GROUP_SIZE} walkers to two guides), so the trail and each lodge are yours alone.
        Departures run {START_DAYS_DISPLAY} until {TAPER_END_DISPLAY}, bookable up to{' '}
        {SADC_WINDOW_MONTHS} months ahead, for start dates from {BOOKING_OPEN_DISPLAY}.
      </p>

      <p class="mt-6 font-body text-base leading-relaxed text-charcoal/85">
        The itinerary, the terrain and the guiding are the same on every departure: see
        <a href={withBase('/the-trail')} class="underline decoration-ochre underline-offset-4">the day-by-day trail</a>
        and <a href={withBase('/logistics')} class="underline decoration-ochre underline-offset-4">trail logistics and safety</a>.
        On this option you bring your own food and cook it in the fully equipped lodge kitchens.
      </p>
    </div>
  </Section>

  <Section bg="cream" labelledby="sadc-book-heading" space="md" containerClass="!pt-0">
    <div id="book" class="max-w-3xl">
      <h2 id="sadc-book-heading" class="font-display text-2xl text-earth sm:text-3xl">
        Book your group
      </h2>
      {
        bookingEnabled ? (
          <Fragment>
            <p class="mt-4 font-body leading-relaxed text-charcoal/85">
              Choose a start date and pay securely by card. Your booking is confirmed once payment
              is received, and a receipt is issued by email.
            </p>
            <div class="mt-8">
              <BookingWidget catering="uncatered" />
            </div>
            <PaymentTrust />
          </Fragment>
        ) : (
          <Fragment>
            <p class="mt-4 font-body leading-relaxed text-charcoal/85">
              Online booking is being finalised. For now, send us an enquiry or message us on
              WhatsApp to check dates and reserve your group.
            </p>
            <p class="mt-6">
              <a href={site.contact.whatsappUrl} class="btn btn-primary" target="_blank" rel="noopener">
                Enquire on WhatsApp
              </a>
            </p>
            {inquiryEnabled && (
              <div class="mt-8">
                <InquiryForm />
              </div>
            )}
          </Fragment>
        )
      }
    </div>
  </Section>

  {/* The same supporting blocks as /rates, in their self-catered versions. */}
  <InclusionsSection included={uncateredInclusions} excluded={uncateredExclusions} />
  <RefundPolicySection catering="uncatered" />
</Layout>
