---
// Home (/) — Part 8.1. Restructured to tease and sell; detail lives on the dedicated pages
// (safety + FAQ on /logistics, pricing + inclusions on /rates). Flow: hero → intro → statement
// band → why → how it works → lodges → testimonials → review → book.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import Testimonials from '../components/Testimonials.astro';
import GoogleReview from '../components/GoogleReview.astro';
import { withBase } from '../data/site';
import { BOOKING_OPEN_DISPLAY, BETA_OPEN_DISPLAY } from '../data/rates';
import { SPLIT_THRESHOLD_DAYS, BALANCE_LEAD_DAYS } from '../lib/pricing';
import { sanctuaries } from '../data/sanctuaries';
import heroImage from '../assets/images/hero-rooiberg-mountains-sunset.jpg';
import panorama from '../assets/images/rooiberg-dusk-panorama.jpg';
import {
  organizationSchema,
  webPageSchema,
  breadcrumbSchema,
  touristTripSchema,
} from '../data/schema';

const title = 'Rooiberg Wander | All-inclusive Big 5 walking safari';
const description =
  'An all-inclusive walking safari in the Waterberg. 3 nights and 3 days on foot through 15,000 ha of malaria-free Big 5 reserve near Rooiberg, Limpopo, 2.5 hours from OR Tambo International Airport, connecting three private safari lodges.';

const jsonLd = [
  organizationSchema,
  webPageSchema({ path: '/', name: title, description }),
  breadcrumbSchema([{ name: 'Home', path: '/' }]),
  touristTripSchema,
];

// Trust-signal band (below the hero). Kept short; the "Why walk" section below covers the detail.
const trustSignals = ['Malaria-Free', 'Experienced Trail Guides', '2.5 hours from OR Tambo Intl Airport'];

// How the trail works — four plain steps.
const steps = [
  {
    n: '1',
    title: 'Choose your dates and book',
    text: `Pick a start date and pay securely online. Full payment is due ${BALANCE_LEAD_DAYS} days before arrival; a 50% deposit holds dates booked ${SPLIT_THRESHOLD_DAYS} or more days ahead.`,
  },
  {
    n: '2',
    title: "Arrive at Temminck's Lodge on start day",
    text: 'Park securely, unpack, register and meet your two guides. Guests settled in before 16h00 can walk to Matopo Lookout Point for sundowners. There is no walking schedule on the arrival day.',
  },
  {
    n: '3',
    title: 'Walk from lodge to lodge',
    text: 'Three walking days of 15 to 20 km, sleeping at a different lodge each night. Your bags travel ahead.',
  },
  {
    n: '4',
    title: 'Finish and head home',
    text: "After the final morning walk, arrive at Temminck's Lodge, freshen up, collect your car or meet your shuttle, and drive home.",
  },
];

// Lodge teasers (image-led) from the shared sanctuaries data.
const lodgeContext: Record<string, string> = {
  rotavi: 'Night 1',
  oukraal: 'Night 2',
  blackwood: 'Night 3',
};
---

<Layout
  title={title}
  description={description}
  path="/"
  navOverHero={true}
  jsonLd={jsonLd}
>
  <Hero
    image={heroImage}
    imageAlt="Golden-hour light over the Waterberg mountain range, Limpopo."
  />
  <StatsBar />

  {/* Trust signals close the same dark band the stats open, so the two read as ONE metadata block
      rather than two stacked ones competing under the hero. */}
  <div class="trust-bar">
    <ul class="trust-bar__list">
      {trustSignals.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  {/* Beta notice, demoted to a slim one-line bar. It previously sat in a full section with its own
      primary + secondary buttons, which put four CTAs above the first content section and let the
      banner outcompete the hero's own call to action. The information stays; the buttons go, because
      the hero already routes to /rates and the enquiry path is reachable from there. */}
  <div class="launch-bar">
    <p class="launch-bar__text">
      <strong>We're in beta.</strong> Online booking opens for start dates from {BOOKING_OPEN_DISPLAY}.
      Earlier dates are available to family and friends at a discount from {BETA_OPEN_DISPLAY}, by
      enquiry or WhatsApp.
    </p>
  </div>

  {/* Intro — short and factual. Detail lives on /the-trail. */}
  <Section bg="cream" labelledby="promise-heading">
    <div class="max-w-3xl">
      <p class="font-body text-2xs font-semibold uppercase tracking-[0.14em] text-green">
        The unpack-and-walk trail
      </p>
      <h2
        id="promise-heading"
        class="mt-4 font-display text-3xl text-earth sm:text-4xl md:text-5xl"
      >
        A three-day walking safari in the Waterberg
      </h2>
      <p class="mt-6 max-w-2xl font-body text-lg leading-relaxed text-charcoal sm:text-xl">
        Rooiberg Wander is a 3-night, 3-day all-inclusive wilderness walking trail, crossed on
        foot rather than viewed from a vehicle, across 15,000 hectares of Big 5 reserve near
        Rooiberg in Limpopo, located just 2.5 hours from OR Tambo International Airport.
        Accommodation consists of characterful, established private bush lodges with a minimum
        booking size for 2 persons. Dining is hearty, wholesome bushveld fare served family-style
        around the boma fire, accompanied by selected South African estate wines and local beers.
      </p>
      <p class="mt-5 max-w-2xl font-body text-base leading-relaxed text-charcoal/85">
        You walk 15 to 20 km per day from one private lodge to the next while your luggage and
        provisions are moved ahead each day. Exclusive: take the whole trail exclusively by booking
        out all 8 spots, so that the trail and each lodge are reserved solely for your group.
      </p>
      <p class="mt-10">
        <a href={withBase('/rates')} class="btn btn-primary">View rates and book the trail</a>
      </p>
    </div>
  </Section>

  {/* Statement band — dark visual break; one factual line over an atmospheric image. */}
  <section class="statement-band" aria-label="About the trail">
    <Image
      class="statement-band__img"
      src={panorama}
      alt="Dusk over the Rooiberg mountains in the Waterberg, Limpopo."
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="statement-band__scrim"></div>
    <div class="statement-band__inner">
      {/* 9 words. Was 21, which read as an over-long kicker set in display type and pushed the
          band to six lines at 390px. It also carried the site's only mention of "RoiSan", an
          entity name that appears nowhere else and is never explained. */}
      <p class="statement-band__text">
        15,000 hectares of Big 5 reserve, crossed on foot.
      </p>
    </div>
  </section>

  {/* How it works — four steps. */}
  <Section bg="cream" space="md" labelledby="how-heading" class="border-t border-hairline">
    <div class="max-w-3xl">
      <p class="font-body text-2xs font-semibold uppercase tracking-[0.14em] text-green">
        Step by step
      </p>
      <h2 id="how-heading" class="mt-4 font-display text-2xl text-earth sm:text-3xl md:text-4xl">
        How the trail works
      </h2>
    </div>
    <ol class="howit">
      {
        steps.map((s) => (
          <li class="howit__step">
            <span class="howit__num" aria-hidden="true">{s.n}</span>
            <h3 class="howit__title">{s.title}</h3>
            <p class="howit__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-10">
      <a href={withBase('/the-trail')} class="btn btn-secondary">See the full day-by-day trail</a>
    </p>
  </Section>

  {/* The lodges — image-led teasers into /accommodation. */}
  <Section bg="cream" space="md" labelledby="lodges-heading" class="border-t border-hairline">
    <div class="max-w-3xl">
      <p class="font-body text-2xs font-semibold uppercase tracking-[0.14em] text-green">
        Where you sleep
      </p>
      <h2 id="lodges-heading" class="mt-4 font-display text-2xl text-earth sm:text-3xl md:text-4xl">
        Three private safari lodges
      </h2>
    </div>
    <ul class="home-lodges">
      {
        sanctuaries.map((s) => (
          <li>
            {/* Deep-links to the lodge's own section rather than the top of /accommodation.
                alt="" is deliberate: the image is decorative HERE because the anchor's own text
                already names the lodge and its role. With the real alt in place the link's
                accessible name ran to ~170 characters, opening with a scene description before
                ever saying which lodge it went to. The full alt still ships on /accommodation,
                where the image is the content rather than a thumbnail. */}
            <a href={withBase(`/accommodation#${s.id}`)} class="home-lodge group">
              <div class="home-lodge__media">
                {s.image && (
                  <Image
                    src={s.image}
                    alt=""
                    class="home-lodge__img"
                    widths={[400, 600]}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    loading="lazy"
                  />
                )}
              </div>
              <p class="home-lodge__context">{lodgeContext[s.id]}</p>
              <h3 class="home-lodge__name">{s.name}</h3>
              <p class="home-lodge__role">{s.role}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-10">
      <a href={withBase('/accommodation')} class="btn btn-secondary">See the lodges</a>
    </p>
  </Section>

  {/* Testimonials — renders only when real reviews exist. */}
  <Testimonials />

  {/* Google review — renders only when the Google Business Profile link is set. */}
  <GoogleReview />

  {/* Final CTA. */}
  <Section bg="earth" space="md" labelledby="cta-heading">
    <div class="max-w-3xl">
      <h2 id="cta-heading" class="font-display text-3xl text-cream sm:text-4xl">
        Ready to walk the Rooiberg Wander?
      </h2>
      <p class="mt-5 max-w-2xl font-body leading-relaxed text-cream/85">
        Check available dates and book online, or explore the full day-by-day itinerary first.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={withBase('/rates')} class="btn btn-primary">Check dates and book</a>
        <a href={withBase('/the-trail')} class="btn btn-ghost">See the trail</a>
      </div>
    </div>
  </Section>
</Layout>
