---
// Rates & Booking (/rates) — Part 8.5, commercial model v4. Sells ONE product: the all-inclusive
// catered walking safari, quoted at the international rack rate. The SADC resident rate is NOT
// mentioned in the copy (operator decision, 16 Sep 2026): it is marketed directly, and the booking
// widget applies it once a guest says where they live. The self-catered option is not shown here
// at all; it lives on the hidden /sadc-slackpacking page.
//
// Copy rule for this page: plain, one fact per sentence, no forward-looking operational detail
// (when more start days open, how far ahead each band books). Those rules are real, but the
// calendar enforces them by simply not offering the date.
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import RatesTable from '../components/RatesTable.astro';
import BookingWidget from '../components/BookingWidget.astro';
import BetaBanner from '../components/BetaBanner.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PaymentTrust from '../components/PaymentTrust.astro';
import InclusionsSection from '../components/InclusionsSection.astro';
import RefundPolicySection from '../components/RefundPolicySection.astro';
import {
  BOOKING_OPEN_DATE,
  NIGHTS,
  MAX_GROUP_SIZE,
  MIN_PARTY_CATERED,
  ROOMS_PER_DEPARTURE,
  RATE_BASE_YEAR,
  formatRand,
  rateFor,
  inclusions,
  exclusions,
} from '../data/rates';
import { todaySast, SPLIT_THRESHOLD_DAYS, BALANCE_LEAD_DAYS } from '../lib/pricing';
import { site, withBase } from '../data/site';
import { webPageSchema, breadcrumbSchema, offerSchema } from '../data/schema';
// Official card-network marks (MIT-licensed set; see src/assets/payment/LICENSE.md).

// Live booking renders only once Supabase + Paystack are configured; until then the page shows
// a "coming soon" note + enquiry. Adding the env vars (then rebuilding) switches it on.
const bookingEnabled = Boolean(
  import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_PAYSTACK_PUBLIC_KEY,
);

// The enquiry form is gated SEPARATELY, on Supabase alone: createInquiry only writes a row and
// emails the operator — it never touches Paystack. Gating it on bookingEnabled meant a missing or
// broken payment key silently removed the enquiry form too, killing the only remaining way to make
// contact in exactly the situation where it matters most.
const inquiryEnabled = Boolean(import.meta.env.PUBLIC_SUPABASE_URL);

// Best-effort default for the enquiry disclosure's initial open/closed state (a static build
// can't know "today" at request time) — BetaBanner's own script corrects both it and the banner
// against the visitor's real date on load, so the page self-corrects after 15 Jan 2027 without
// a redeploy.
const isBetaAtBuildTime = todaySast() < BOOKING_OPEN_DATE;

// The two figures the page leads with, both derived so a rate change moves the copy with it.
const intlLow = rateFor({ catering: 'catered', residency: 'international', year: RATE_BASE_YEAR, highSeason: false });
const intlHigh = rateFor({ catering: 'catered', residency: 'international', year: RATE_BASE_YEAR, highSeason: true });

const title = 'Rates & Booking | Rooiberg Wander';
const description = `An all-inclusive walking safari from ${formatRand(intlLow)} per person, sharing, for the whole ${NIGHTS}-night trail, VAT and conservation levies included. See what is included and book online.`;

const included = inclusions;
const excluded = exclusions;

const jsonLd = [
  webPageSchema({ path: '/rates', name: title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Rates & Booking', path: '/rates' },
  ]),
  offerSchema({
    price: intlLow,
    name: 'Rooiberg Wander: all-inclusive catered walking safari, per person sharing',
    description: `From this rate per person sharing, for the whole ${NIGHTS}-night trail: all meals with selected South African wines and beers, two trail guides, daily baggage transport, all conservation levies and VAT. From ${MIN_PARTY_CATERED} guests up to ${MAX_GROUP_SIZE}.`,
  }),
];
---

<Layout title={title} description={description} path="/rates" jsonLd={jsonLd}>
  <Section bg="cream" labelledby="rates-heading" space="md">
    <div class="max-w-3xl">
      <p class="font-body text-2xs font-semibold uppercase tracking-[0.14em] text-green">
        Rates &amp; Booking
      </p>
      <h1 id="rates-heading" class="mt-4 font-display text-4xl text-earth sm:text-5xl md:text-6xl">
        What the trail costs
      </h1>
      <p class="mt-6 font-body text-lg leading-relaxed text-charcoal sm:text-xl">
        One price per person for the whole {NIGHTS}-night trail, VAT and conservation levies
        included. You pay for the people in your group, from {MIN_PARTY_CATERED} guests up. The price
        depends on the season you walk in.
      </p>
    </div>
  </Section>

  <Section bg="cream" space="sm" containerClass="!pt-0">
    <BetaBanner />
  </Section>

  <Section bg="cream" labelledby="matrix-heading" space="md" containerClass="!pt-0">
    {/* One column width for the whole section: the heading used to run the full container width
        while the rate card below it was capped at max-w-3xl, so the card read as indented under
        its own title. Heading, card and the steps below now share the same measure. */}
    <div class="max-w-3xl">
      <h2 id="matrix-heading" class="font-display text-2xl text-earth sm:text-3xl">
        Rates at a glance
      </h2>

      <div class="mt-6">
        <RatesTable />

        <p class="rate-includes">
          <strong>Every rate includes</strong> two trail guides &middot; all meals, with selected
          South African estate wines and local beers &middot; daily baggage transport &middot; all
          conservation levies and VAT
        </p>

        <p class="mt-5 font-body text-base leading-relaxed text-charcoal/85">
          {/* The link text is on one line: indenting it inside the anchor pulls the template's
              own newline into the link, underlining a trailing space. */}
          See <a href={withBase('/how-pricing-works')} class="underline decoration-ochre underline-offset-4">How pricing works</a> for a worked example.
        </p>
      </div>

      {/* The practical rules, in the order a guest meets them. Deliberately plain: every sentence
          states one fact, with no forward-looking operational detail (when more start days open,
          how far ahead each rate band books). Those are real rules, but they belong to the
          calendar, which simply will not offer a date that breaks them. */}
      <h3 class="mt-12 font-display text-xl text-earth sm:text-2xl">How booking works</h3>
      <ul class="bookrules">
        <li>
          <p class="bookrules__days">Step 1</p>
          <p class="bookrules__title">Pick your group and a date</p>
          <p class="bookrules__body">
            Up to {MAX_GROUP_SIZE} guests in {ROOMS_PER_DEPARTURE} double rooms, with two trail
            guides.
          </p>
          <details class="bookrules__more">
            <summary>More info</summary>
            <p class="bookrules__body">
              Tell us how many rooms you need and how many of you live in an SADC country, and the
              calendar shows every date you can start on.
            </p>
          </details>
        </li>
        <li>
          <p class="bookrules__days">Step 2</p>
          <p class="bookrules__title">You may be walking with others</p>
          <p class="bookrules__body">You only ever share a room with your own group.</p>
          <details class="bookrules__more">
            <summary>More info</summary>
            <p class="bookrules__body">
              If you take fewer than {ROOMS_PER_DEPARTURE} rooms, other guests can book the same
              date. Take all {ROOMS_PER_DEPARTURE} rooms and the trail and the lodges are yours
              alone.
            </p>
          </details>
        </li>
        <li>
          <p class="bookrules__days">Step 3</p>
          <p class="bookrules__title">Pay and you are booked</p>
          <p class="bookrules__body">
            Pay by card. We email your confirmation and receipt straight away.
          </p>
        </li>
      </ul>
    </div>
  </Section>

  {/* Booking area — live BookingWidget when configured, else a calm "coming soon" + enquiry.
      Sits directly after the rates so the conversion action is reached without first scrolling
      past the full included/excluded lists, which now follow it as supporting detail. */}
  <Section bg="cream" labelledby="book-heading" space="md" containerClass="!pt-0">
    <div id="book" class="max-w-3xl">
      <h2 id="book-heading" class="font-display text-2xl text-earth sm:text-3xl">
        Booking the trail
      </h2>
      {
        bookingEnabled ? (
          <Fragment>
            <p class="mt-4 font-body leading-relaxed text-charcoal/85">
              Choose your group size and rooms, pick a start date and pay by card.
              Your booking is confirmed as soon as the payment goes through.
            </p>

            {/* Booking-confidence strip — the friendliest policy facts, at the point of hesitation. */}
            <ul class="booking-assure">
              <li>
                <span class="booking-assure__icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v4m8-4v4M4 9h16M5 5h14a1 1 0 0 1 1 1v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a1 1 0 0 1 1-1Z"/></svg>
                </span>
                50% deposit secures dates {SPLIT_THRESHOLD_DAYS}+ days out; full payment is due{' '}
                {BALANCE_LEAD_DAYS} days before arrival
              </li>
              <li>
                <span class="booking-assure__icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.4 3 8.4 7 9.5 4-1.1 7-5.1 7-9.5V6l-7-3Zm-2.5 9 2 2 3.5-4"/></svg>
                </span>
                Instant confirmation and a receipt with every payment
              </li>
            </ul>

            <div class="mt-8">
              <BookingWidget />
            </div>

            {/* Payment trust row — secure-checkout cue at the point of payment. */}
            <PaymentTrust />
          </Fragment>
        ) : (
          <div class="booking-placeholder">
            <p class="font-body leading-relaxed text-charcoal/85">
              Online booking is being finalised. For now, send us an enquiry or message us on
              WhatsApp to check dates and reserve your group.
            </p>
            {/* The enquiry form is still on this page when booking is off (it needs Supabase, not
                Paystack), so point at it here — otherwise the one path that still works in this
                state goes unsignposted. Guarded so it can never become a dead link. */}
            <div class="mt-6 flex flex-wrap gap-4">
              {inquiryEnabled && (
                <a href="#enquire-heading" class="btn btn-primary">
                  Send an enquiry
                </a>
              )}
              <a
                href={site.contact.whatsappUrl}
                target="_blank"
                rel="noopener"
                class:list={['btn', inquiryEnabled ? 'btn-secondary' : 'btn-primary']}
              >
                Enquire on WhatsApp
              </a>
            </div>
            <p class="mt-4 font-body text-base text-charcoal/70">
              Secure online booking with instant confirmation is coming soon.
            </p>
          </div>
        )
      }
    </div>
  </Section>

  {/* Included / to arrange — supporting detail. A one-line summary already sits under the rate
      table, so this full breakdown follows the widget rather than delaying it. */}
  <InclusionsSection included={included} excluded={excluded} />

  {/* Refund & cancellation policy (Part 9 / draft in policies.ts). Also referenced at checkout.
      Two summary lines stay visible at all times; the full schedule and clauses collapse into a
      native accordion below them. Policy text itself is unchanged, just re-presented. */}
  <RefundPolicySection />

  {/* Enquiry — last section of the page. Open (prominent) while online booking is not yet open
      (before BOOKING_OPEN_DATE); collapses behind a disclosure once booking opens. BetaBanner's
      script sets `open` on load using the visitor's real date, so this self-corrects without a
      deploy. The #enquire-heading anchor is linked from the beta banner and other pages. */}
  {
    inquiryEnabled && (
      <Section bg="cream" labelledby="enquire-heading" space="md" containerClass="!pt-0">
        <details class="enquire-disclosure" data-enquire-disclosure data-until={BOOKING_OPEN_DATE} open={isBetaAtBuildTime}>
          <summary class="enquire-disclosure__summary">Prefer to talk to us first?</summary>
          <div class="enquire-disclosure__body max-w-3xl">
            <h2 id="enquire-heading" class="font-display text-2xl text-earth sm:text-3xl">
              Enquire first
            </h2>
            <p class="mt-4 font-body leading-relaxed text-charcoal/85">
              Send us your details and target dates and we’ll be in touch.
            </p>
            <p class="mt-2">
              <a href={site.contact.whatsappUrl} target="_blank" rel="noopener" class="enquire-disclosure__whatsapp">
                or WhatsApp {site.contact.name}
              </a>
            </p>
            <div class="mt-8">
              <InquiryForm />
            </div>
          </div>
        </details>
      </Section>
    )
  }
</Layout>
