---
// How pricing works (/how-pricing-works) — the explainer behind the rate matrix on /rates.
//
// The rates page answers "what does it cost". This page answers "why is it that", which is the
// question that stalls a booking: four independent things move the per-person price for the whole
// trail (never a per-night figure, since there is no shorter stay to choose), and until a guest
// can see which one applies to them the matrix reads as arbitrary.
//
// EVERY figure here is computed from data/rates.ts and lib/pricing.ts. Nothing on this page is
// typed by hand, because an explainer that disagrees with the calculator is worse than none.
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import {
  NIGHTS,
  MAX_GROUP_SIZE,
  MIN_PARTY_CATERED,
  ROOMS_PER_DEPARTURE,
  SINGLE_SUPPLEMENT_PCT,
  MIN_TO_JOIN,
  RATE_BASE_YEAR,
  RATE_YEARS,
  RATE_YEAR_MULTIPLIER,
  SEASON_DISCOUNT,
  SEASON_HIGH_DATES,
  LAST_MINUTE_DISCOUNT,
  LAST_MINUTE_MIN_DAYS,
  LAST_MINUTE_MAX_DAYS,
  START_DAYS_DISPLAY,
  TAPER_END_DISPLAY,
  FROM_PP_TRIP_DISPLAY,
  formatRand,
  rateFor,
  inclusions,
  exclusions,
} from '../data/rates';
import { SPLIT_THRESHOLD_DAYS, BALANCE_LEAD_DAYS, ppTripCentsFor, isHighSeason } from '../lib/pricing';
import { withBase } from '../data/site';
import { webPageSchema, breadcrumbSchema, faqPageSchema } from '../data/schema';

const title = 'How pricing works';
const description = `Rates are per person sharing, for the whole trail, from ${FROM_PP_TRIP_DISPLAY}, VAT and conservation levies included. Three things move the price: the season, the year you travel, and how far ahead you book.`;

const lastMinutePct = Math.round(LAST_MINUTE_DISCOUNT * 100);
const seasonPct = Math.round(SEASON_DISCOUNT * 100);

// This page quotes the published (international) rate only. The resident rate exists in the
// engine but is marketed directly, so it is never explained or shown here.
const rate = (year: number, highSeason: boolean) =>
  formatRand(rateFor({ catering: 'catered', residency: 'international', year, highSeason }));

// The increase from the base year to the next published year, stated as the operator set it.
const nextYear = RATE_YEARS.find((y) => y > RATE_BASE_YEAR) ?? RATE_BASE_YEAR;
const nextYearPct = Math.round((RATE_YEAR_MULTIPLIER[nextYear] / RATE_YEAR_MULTIPLIER[RATE_BASE_YEAR] - 1) * 100);

// The factors, each with its effect stated in the rates the table actually carries. Residency is
// deliberately NOT among them: the resident rate is marketed directly, not explained here.
const factors = [
  {
    q: 'What counts as high season?',
    lead: `${SEASON_HIGH_DATES}. Every other date is low season, at ${seasonPct}% less.`,
    body: `The season depends only on your start date: ${rate(RATE_BASE_YEAR, true)} per person in high season against ${rate(RATE_BASE_YEAR, false)} in low. Everything else about the trail is identical.`,
  },
  {
    q: 'Which year\'s rate applies to me?',
    lead: 'The rate for the year your trail starts in, locked in when you book.',
    body: `Rates are published two years ahead, because tour operators need them that far in advance. A trail starting in ${RATE_BASE_YEAR} high season is ${rate(RATE_BASE_YEAR, true)} per person; one starting in ${nextYear} is ${rate(nextYear, true)}. Whichever applies to your start date is the rate you pay, and it does not change after you book.`,
  },
  {
    q: 'Is there a discount for booking late?',
    lead: `Yes. Departures between ${LAST_MINUTE_MIN_DAYS} and ${LAST_MINUTE_MAX_DAYS} days away are ${lastMinutePct}% less.`,
    body: `It is applied automatically: you will see it named on the date you pick and again on your total before you pay. Nothing needs to be asked for or entered. The last week before departure is closed for online booking, because that week is reserved for staffing your trail.`,
  },
];

// A worked example, computed rather than typed, so the arithmetic on this page is the arithmetic
// in the calculator. A fixed "now" is deliberate: a far-future date so the example is never
// silently altered by the last-minute window as the date approaches.
//
// The DESCRIPTION is derived too, not written alongside the date. Writing "low season" next to a
// date is exactly how this page ends up contradicting itself.
const exampleIso = '2027-11-15';
const exampleParty = 4;
const exampleResidency = 'international' as const; // the published rate
const exampleNow = new Date('2027-01-20T00:00:00Z');
const exampleDate = new Date(exampleIso + 'T00:00:00Z');
const exampleWeekday = exampleDate.toLocaleDateString('en-ZA', { timeZone: 'UTC', weekday: 'long' });
const exampleSeason = isHighSeason(exampleIso) ? 'high season' : 'low season';
const examplePp = ppTripCentsFor('catered', exampleResidency, exampleIso, exampleNow);
const exampleTotal = examplePp * exampleParty;
const exampleDeposit = Math.round(exampleTotal / 2);
const asRand = (cents: number) => formatRand(cents / 100);

const exampleLines: Array<[string, string]> = [
  [`All-inclusive, ${exampleSeason}, ${exampleWeekday} start`, `${asRand(examplePp)} per person sharing`],
  [`${exampleParty} walkers`, asRand(exampleTotal)],
  ['Paid today (50% deposit)', asRand(exampleDeposit)],
  [`Balance, due ${BALANCE_LEAD_DAYS} days before arrival`, asRand(exampleTotal - exampleDeposit)],
];

const jsonLd = [
  webPageSchema({ path: '/how-pricing-works', name: title, description }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Rates & Booking', path: '/rates' },
    { name: 'How pricing works', path: '/how-pricing-works' },
  ]),
  faqPageSchema(factors.map((f) => ({ q: f.q, a: `${f.lead} ${f.body}` }))),
];
---

<Layout title={title} description={description} path="/how-pricing-works" jsonLd={jsonLd}>
  <Section bg="cream" labelledby="pricing-heading" space="lg">
    <div class="max-w-3xl">
      <p class="font-body text-2xs font-semibold uppercase tracking-[0.14em] text-green">
        Rates explained
      </p>
      <h1 id="pricing-heading" class="mt-4 font-display text-4xl text-earth sm:text-5xl md:text-6xl">
        How pricing works
      </h1>
      <p class="mt-6 font-body text-lg leading-relaxed text-charcoal sm:text-xl">
        Rates are per person sharing, for the whole {NIGHTS}-night trail, from{' '}
        {FROM_PP_TRIP_DISPLAY}, with VAT and all conservation levies included. Three things move
        that price: the season, the year you travel, and how far ahead you book. Nothing else is
        added at checkout.
      </p>
    </div>
  </Section>

  {/* Answer-first Q&A: each heading is a question a guest actually asks, answered in the first
      sentence. Serves readers, search, and the generative engines that quote the first line. */}
  <Section bg="cream" labelledby="factors-heading" space="md" containerClass="!pt-0">
    <div class="max-w-3xl">
      <h2 id="factors-heading" class="font-display text-2xl text-earth sm:text-3xl">
        What moves the price
      </h2>
      <div class="mt-6 grid gap-7">
        {
          factors.map((factor) => (
            <div>
              <h3 class="font-display text-xl text-earth">{factor.q}</h3>
              <p class="mt-2 font-body leading-relaxed text-charcoal">
                <strong>{factor.lead}</strong>
              </p>
              <p class="mt-2 font-body leading-relaxed text-charcoal/85">{factor.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section bg="earth" labelledby="example-heading" space="md">
    <div class="max-w-3xl">
      <h2 id="example-heading" class="font-display text-2xl text-cream sm:text-3xl">
        A worked example
      </h2>
      <p class="mt-4 font-body leading-relaxed text-cream/85">
        {exampleParty} walkers, all-inclusive, starting on a {exampleWeekday} in{' '}
        {exampleSeason}. Every line is the same calculation the booking form runs, so this is what
        you would actually be charged.
      </p>
      <dl class="pricing-example">
        {
          exampleLines.map(([label, value]) => (
            <div class="pricing-example__row">
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-5 font-body text-base leading-relaxed text-cream/70">
        Departures {SPLIT_THRESHOLD_DAYS} or more days away are secured with a 50% deposit, with
        the balance due {BALANCE_LEAD_DAYS} days before arrival. Inside that, the full amount is
        due at booking.
      </p>
    </div>
  </Section>

  <Section bg="cream" labelledby="group-heading" space="md">
    <div class="max-w-3xl">
      <h2 id="group-heading" class="font-display text-2xl text-earth sm:text-3xl">
        Do I pay for my whole group, or just myself?
      </h2>
      <p class="mt-4 font-body leading-relaxed text-charcoal">
        <strong>Just the people you are booking for.</strong> The rate is per person sharing, for
        the whole trail, so a party of {MIN_PARTY_CATERED} pays for {MIN_PARTY_CATERED} even on a
        date where others join later. A departure carries up to {MAX_GROUP_SIZE} walkers in
        {' '}{ROOMS_PER_DEPARTURE} double rooms, with two trail guides.
      </p>
      <p class="mt-4 font-body leading-relaxed text-charcoal/85">
        The first booking on a date opens it, from {MIN_PARTY_CATERED} guests. Once a date has a
        booking it is a guaranteed departure, and any party of {MIN_TO_JOIN} or more can join it
        while rooms last. You only ever share a room with your own group, and each guest in a room
        of their own pays a {SINGLE_SUPPLEMENT_PCT}% single supplement. Take all
        {' '}{ROOMS_PER_DEPARTURE} rooms and the trail and each lodge are reserved for your group
        alone, with nobody joining you.
      </p>
      <p class="mt-4 font-body leading-relaxed text-charcoal/85">
        Departures run {START_DAYS_DISPLAY} until {TAPER_END_DISPLAY}, and every weekday from 2029.
  
      </p>
    </div>
  </Section>

  <Section bg="cream" labelledby="included-heading" space="md" containerClass="!pt-0">
    <div class="max-w-3xl">
      <h2 id="included-heading" class="font-display text-2xl text-earth sm:text-3xl">
        What is included in the rate?
      </h2>
      <div class="mt-5 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="font-body text-sm font-bold uppercase tracking-[0.08em] text-green">
            Included
          </h3>
          <ul class="incl-list incl-list--in mt-3">
            {inclusions.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-body text-sm font-bold uppercase tracking-[0.08em] text-earth/70">
            Not included
          </h3>
          <ul class="incl-list incl-list--out mt-3">
            {exclusions.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <p class="mt-8">
        <a href={withBase('/rates')} class="btn btn-primary">See the rate table and book</a>
      </p>
    </div>
  </Section>
</Layout>
