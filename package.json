{
  "name": "rooiberg-wander",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "audit": "npm audit --audit-level=high",
    "a11y": "axe http://localhost:4321 --exit",
    "lh": "lhci autorun",
    "verify": "npm run check && npm run build && npm run audit",
    "verify:marketing": "tsx scripts/verify-marketing.mjs",
    "marketing:sync": "tsx marketing/sync.ts",
    "marketing:run": "tsx marketing/run.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "4.3.1",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.1",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@astrojs/check": "^0.9.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.3",
    "docx": "^9.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
